# =============================================================================
# GovScale environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GOVSCALE_SECRET_KEY=

# Initial administrator account.
GOVSCALE_ADMIN_EMAIL=admin@example.com
GOVSCALE_ADMIN_PASSWORD=

# Optional demo-user password. Used only by the `demo` Compose profile.
GOVSCALE_DEMO_PASSWORD=

# Application database.
# Compose sets this automatically for PostgreSQL; leave blank for local SQLite.
# Example external database:
# postgresql+psycopg2://govscale:password@localhost:5432/govscale
GOVSCALE_DATABASE_URI=

# PostgreSQL password used by Compose. Use a long random value.
POSTGRES_PASSWORD=

# Host port mappings.
GOVSCALE_HOST_PORT=5000
GOVSCALE_PG_HOST_PORT=5433

# Gunicorn tuning.
WEB_CONCURRENCY=3
GUNICORN_THREADS=4

# Optional SQLite-only initialization.
# Do not enable this when using the Compose `init` and `admin-init` services.
