{% extends "base.html" %}

{% block title %}My Dashboard | GovScale{% endblock %}

{% block content %}
<section class="dashboard-section">
    <span class="section-kicker">YOUR STUDENT SPACE</span>

    <h1>Welcome, {{ current_user.full_name }}!</h1>

    <p class="dashboard-intro">
        Discover scholarships, prepare for exams, and keep your opportunities
        in one place.
    </p>

    <div class="dashboard-grid">

        <article class="dashboard-card">
            <span class="dashboard-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7h18l-2 5H5L3 7Z"/>
                    <path d="M5 12v5h14v-5"/>
                    <path d="M7 17v3h10v-3"/>
                    <path d="M7 4h10"/>
                </svg>
            </span>

            <h2>Grade-based</h2>
            <p>Scholarships based on academic grades and performance.</p>

            <p class="dashboard-stat">{{ grade_count }}</p>

            <a class="text-link"
               href="{{ url_for('scholarship_category', category='grade') }}">
                Available opportunities →
            </a>
        </article>

        <article class="dashboard-card">
            <span class="dashboard-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="3" width="14" height="18" rx="2"/>
                    <path d="M9 7h6"/>
                    <path d="m9 12 2 2 4-4"/>
                    <path d="M9 17h6"/>
                </svg>
            </span>

            <h2>Exam-based</h2>
            <p>Scholarships connected to an examination or assessment.</p>

            <p class="dashboard-stat">{{ exam_count }}</p>

            <a class="text-link"
               href="{{ url_for('scholarship_category', category='exam') }}">
                Available opportunities →
            </a>
        </article>

    </div>

    {% if registered_exam %}
    <div class="dashboard-card exam-countdown-card">
        <span class="section-kicker">YOUR REGISTERED EXAM</span>

        <h2>{{ registered_exam.scholarship.title if registered_exam.scholarship else 'Registered Scholarship Exam' }}</h2>

        <p>
            Scheduled for {{ registered_exam.start_at.strftime("%d %B %Y") }}
            at {{ registered_exam.start_at.strftime("%I:%M %p") }} IST.
        </p>

        <div class="countdown-panel" id="exam-countdown-panel">
            <span class="countdown-heading" id="exam-countdown-heading">COUNTDOWN TO THE EXAM</span>
            <div id="exam-countdown" class="countdown-grid" aria-live="off">
                <div class="countdown-unit"><strong id="exam-days">00</strong><span>Days</span></div>
                <div class="countdown-unit"><strong id="exam-hours">00</strong><span>Hours</span></div>
                <div class="countdown-unit"><strong id="exam-minutes">00</strong><span>Minutes</span></div>
                <div class="countdown-unit"><strong id="exam-seconds">00</strong><span>Seconds</span></div>
            </div>
            <p id="exam-countdown-message" class="countdown-message">Your exam will start soon.</p>
        </div>

        <a href="{{ url_for('exam_entry', exam_id=registered_exam.id) }}"
        class="exam-action">
            Start Exam <span aria-hidden="true">→</span>
        </a>
    </div>
    {% endif %}

    <div class="dashboard-grid dashboard-quick-links">
        <article class="dashboard-card">
            <h2>My Profile</h2>
            <p>Review your education, institution, and academic details.</p>
            <a class="text-link" href="{{ url_for('student_profile') }}">
                View my profile →
            </a>
        </article>

        
        <article class="dashboard-card">
            <h2>My Applications</h2>
            <p>
                View your submitted scholarship applications and
                check their current status.
            </p>
            <a class="text-link"
               href="{{ url_for('my_applications') }}">
                View my applications →
            </a>
        </article>
    </div>
</section>



    <section id="exam-history-section" class="dashboard-card" aria-labelledby="exam-history-title">
        <span class="section-kicker">YOUR EXAMS</span>
        <h2 id="exam-history-title">Exam History</h2>
        <p>Review your registrations, completed exams, and missed exams.</p>

        {% if exam_history %}
        <div class="exam-history-list">
            {% for item in exam_history %}
            <article class="exam-history-item">
                <h3>{{ item.exam.scholarship.title if item.exam.scholarship else item.exam.title }}</h3>
                <p>
                    Scheduled: {{ item.exam.start_at.strftime("%d %b %Y, %I:%M %p") }} IST
                </p>
                <p>
                    Status:
                    {% if item.registration.status == "completed" and item.submission %}
                        <strong>Completed</strong>
                    {% elif item.registration.status == "missed" %}
                        <strong>Missed</strong>
                    {% elif item.registration.status == "cancelled" %}
                        <strong>Cancelled</strong>
                    {% else %}
                        <strong>Registered</strong>
                    {% endif %}
                </p>

                {% if item.submission %}
                <p>
                    Score: {{ item.submission.score }} / {{ item.submission.total_marks }}
                    ({{ "%.2f"|format(item.submission.percentage) }}%)
                </p>
                <a class="text-link" href="{{ url_for('exam_review', exam_id=item.exam.id) }}">
                    Review Exam →
                </a>
                {% elif item.registration.status == "missed" %}
                <p>No submission was received before the exam ended. Results are unavailable.</p>
                {% elif item.registration.status == "registered" and item.exam.is_active %}
                <a class="text-link" href="{{ url_for('exam_entry', exam_id=item.exam.id) }}">
                    Open exam details →
                </a>
                {% endif %}
            </article>
            {% endfor %}
        </div>
        {% else %}
        <p>You haven't registered for an exam yet. Registered exams will appear here.</p>
        {% endif %}
    </section>



<script>
document.addEventListener("DOMContentLoaded", function () {
    const countdown = document.getElementById("exam-countdown");
    if (!countdown) return;

    const startIso = {{ registered_exam_start_iso | tojson }};
    const endIso = {{ registered_exam_end_iso | tojson }};
    const startUrl = {{ registered_exam_start_url | tojson }};

    if (!startIso || !endIso || !startUrl) return;

    const startTime = new Date(startIso).getTime();
    const endTime = new Date(endIso).getTime();

    const fields = {
        days: document.getElementById("exam-days"),
        hours: document.getElementById("exam-hours"),
        minutes: document.getElementById("exam-minutes"),
        seconds: document.getElementById("exam-seconds")
    };

    const heading = document.getElementById("exam-countdown-heading");
    const message = document.getElementById("exam-countdown-message");

    function updateCountdown() {
        const now = Date.now();
        let remaining;

        if (now < startTime) {
            remaining = startTime - now;
            heading.textContent = "COUNTDOWN TO THE EXAM";
            message.textContent = "Your exam will start soon. Open the exam page for details.";
        } else if (now < endTime) {
            heading.textContent = "EXAM WINDOW OPEN";
            message.textContent = "Your exam is available. Click Start Exam when you're ready.";
            fields.days.textContent = "00";
            fields.hours.textContent = "00";
            fields.minutes.textContent = "00";
            fields.seconds.textContent = "00";
            return;
        } else {
            countdown.textContent = "Exam concluded";
            heading.textContent = "EXAM COMPLETED";
            message.textContent = "This exam has concluded.";
            return;
        }

        fields.days.textContent = String(Math.floor(remaining / 86400000)).padStart(2, "0");
        fields.hours.textContent = String(Math.floor((remaining % 86400000) / 3600000)).padStart(2, "0");
        fields.minutes.textContent = String(Math.floor((remaining % 3600000) / 60000)).padStart(2, "0");
        fields.seconds.textContent = String(Math.floor((remaining % 60000) / 1000)).padStart(2, "0");
    }

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
});
</script>


{% endblock %}
