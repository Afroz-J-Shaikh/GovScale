{% extends "base.html" %}
{% block title %}Payment Details | GovScale{% endblock %}
{% block content %}
<section class="payment-page">
    <div class="payment-page-heading">
        <span class="payment-eyebrow">SCHOLARSHIP REWARDS</span>
        <h1>Payment details</h1>
        <p>Choose how you would like to receive your scholarship reward.</p>
    </div>

    <article class="payment-panel">
        {% if pending_payout %}
        <div class="payment-lock-notice" role="status">
            <span class="payment-notice-icon" aria-hidden="true">✓</span>
            <div>
                <strong>Details temporarily locked</strong>
                <p>An administrator must resolve your pending payout before these details can be changed.</p>
            </div>
        </div>
        {% endif %}

        <form method="POST" action="{{ url_for('payment_details') }}" id="payment-details-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <div class="payment-section-heading">
                <span class="payment-step">1</span>
                <div>
                    <h2>Choose a payment method</h2>
                    <p>Select the destination type for your reward.</p>
                </div>
            </div>

            <div class="payment-method-options" role="radiogroup" aria-label="Payment method">
                <label class="payment-method-option">
                    <input type="radio" name="payment_method" value="upi_simulated"
                        {% if not details or details.payment_method == "upi_simulated" %}checked{% endif %}
                        {% if pending_payout %}disabled{% endif %}>
                    <span class="payment-method-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/><rect x="2.5" y="3.5" width="19" height="17" rx="3"/></svg>
                    </span>
                    <strong>UPI</strong>
                    <small>UPI ID</small>
                </label>
                <label class="payment-method-option">
                    <input type="radio" name="payment_method" value="bank_simulated"
                        {% if details and details.payment_method == "bank_simulated" %}checked{% endif %}
                        {% if pending_payout %}disabled{% endif %}>
                    <span class="payment-method-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="m3 9 9-6 9 6M5 10v8m4-8v8m6-8v8m4-8v8M3 21h18M2 18h20"/></svg>
                    </span>
                    <strong>Bank transfer</strong>
                    <small>Account reference</small>
                </label>
                <label class="payment-method-option">
                    <input type="radio" name="payment_method" value="wallet_simulated"
                        {% if details and details.payment_method == "wallet_simulated" %}checked{% endif %}
                        {% if pending_payout %}disabled{% endif %}>
                    <span class="payment-method-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 9h18m-5 5h2"/></svg>
                    </span>
                    <strong>Wallet</strong>
                    <small>Wallet reference</small>
                </label>
            </div>

            <div class="payment-divider"></div>

            <div class="payment-section-heading">
                <span class="payment-step">2</span>
                <div>
                    <h2>Recipient information</h2>
                    <p>Enter the fictional details for your selected method.</p>
                </div>
            </div>

            <div class="payment-form-grid">
                <div class="payment-field payment-field-full">
                    <label for="recipient_name">Recipient name</label>
                    <input id="recipient_name" name="recipient_name" type="text"
                        autocomplete="off" maxlength="100" required
                        placeholder="Enter recipient name"
                        value="{{ details.recipient_name if details else '' }}"
                        {% if pending_payout %}disabled{% endif %}>
                </div>

                <div class="payment-field payment-field-full">
                    <label for="recipient_reference" id="reference-label">UPI ID</label>
                    <input id="recipient_reference" name="recipient_reference" type="text"
                        autocomplete="off" maxlength="120" required
                        placeholder="example@bank"
                        value="{{ details.recipient_reference if details else '' }}"
                        {% if pending_payout %}disabled{% endif %}>
                    <small class="payment-field-hint" id="reference-hint">Enter a fictional UPI ID, for example learner@demo.</small>
                </div>
            </div>

            <div class="payment-saved-preview" id="payment-preview" aria-live="polite">
                <span class="payment-preview-symbol" aria-hidden="true">✓</span>
                <div>
                    <strong id="preview-method">
                        {% if details and details.payment_method == "bank_simulated" %}Bank transfer
                        {% elif details and details.payment_method == "wallet_simulated" %}Wallet
                        {% else %}UPI{% endif %}
                    </strong>
                    <p>Your selected destination will be saved to your GovScale profile.</p>
                </div>
            </div>

            <div class="payment-actions">
                <button class="payment-save-button" type="submit"
                    {% if pending_payout %}disabled{% endif %}>
                    {{ "Update payment details" if details else "Save payment details" }}
                    <span aria-hidden="true">→</span>
                </button>
                {% if details %}
                <button class="payment-remove-button" type="submit" form="remove-payment-details"
                    {% if pending_payout %}disabled{% endif %}>Remove saved details</button>
                {% endif %}
            </div>
        </form>

        {% if details %}
        <form id="remove-payment-details" method="POST" action="{{ url_for('payment_details') }}"
              onsubmit="return confirm('Remove your saved payment details?');">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="action" value="delete">
        </form>
        <p class="payment-last-updated">Last updated: {{ details.updated_at|ist_datetime }}</p>
        {% endif %}
    </article>

    <div class="payment-page-footer">
        <a href="{{ url_for('dashboard') }}" class="payment-back-link">← Back to dashboard</a>
        <p>Demo only — no real payments are processed. Use fictional test details.</p>
    </div>
</section>

<script>
(function () {
    const radios = document.querySelectorAll('input[name="payment_method"]');
    const label = document.getElementById('reference-label');
    const input = document.getElementById('recipient_reference');
    const hint = document.getElementById('reference-hint');
    const preview = document.getElementById('preview-method');

    const methods = {
        upi_simulated: {
            name: 'UPI',
            label: 'UPI ID',
            placeholder: 'learner@okaxis',
            hint: 'Enter a UPI-style ID in the format name@handle. Use fictional test details only.'
        },
        bank_simulated: {
            name: 'Bank transfer',
            label: 'Bank account number',
            placeholder: '465 654 54654',
            hint: 'Enter 9–18 digits; spaces or hyphens are allowed. Use a fictional test number only.'
        },
        wallet_simulated: {
            name: 'Wallet',
            label: 'Wallet ID or mobile number',
            placeholder: '9876543210',
            hint: 'Enter a wallet-style ID or 10-digit mobile-style number. Use fictional test details only.'
        }
    };

    function updateMethod() {
        const selected = document.querySelector('input[name="payment_method"]:checked');
        if (!selected) return;
        const method = methods[selected.value];
        label.textContent = method.label;
        input.placeholder = method.placeholder;
        hint.textContent = method.hint;
        preview.textContent = method.name;
    }

    radios.forEach(function (radio) {
        radio.addEventListener('change', updateMethod);
    });
    updateMethod();
})();
</script>
{% endblock %}
