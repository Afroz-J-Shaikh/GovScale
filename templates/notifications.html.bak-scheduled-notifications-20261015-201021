{% extends "admin/base_admin.html" if current_user.is_admin else "base.html" %}
{% block title %}Notifications | GovScale{% endblock %}
{% block content %}
<section class="{% if current_user.is_admin %}admin-section{% else %}dashboard-section{% endif %}">
    <h1>Notifications</h1>
    <p>Notifications stay here until you close them. Opening this page marks them as read.</p>
    {% if notifications %}
        <div class="notification-inbox-list">
        {% for notification in notifications %}
            <article class="notification-inbox-item {% if not notification.is_read %}is-unread{% endif %}">
                <div class="notification-inbox-content">
                    <h2>{{ notification.title }}</h2>
                    <p>{{ notification.message }}</p>
                    {% if notification.link and notification.link.startswith("/") %}
                    <p><a href="{{ url_for('open_notification', notification_id=notification.id) }}">View details →</a></p>
                    {% endif %}
                </div>
                <div class="notification-inbox-meta">
                    <small>{{ notification.created_at.strftime("%d %b %Y") }}</small>
                    <small>{{ notification.created_at.strftime("%I:%M %p") }} IST</small>
                </div>
                <form method="POST" action="{{ url_for('close_notification', notification_id=notification.id) }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" class="notification-close-button">Close ×</button>
                </form>
            </article>
        {% endfor %}
        </div>
    {% else %}
        <p>You have no notifications.</p>
    {% endif %}
</section>
{% endblock %}
