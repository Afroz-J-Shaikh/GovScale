{% extends "base.html" %}
{% block title %}Payment Details | GovScale{% endblock %}
{% block content %}
<section class="dashboard-section">
    <h1>Payment Details</h1>
    <p class="dashboard-intro">
        Maintain simulated recipient details for scholarship reward demonstrations.
        This feature does not transfer real money.
    </p>

    <article class="dashboard-card">
        <h2>Demo-only information</h2>
        <p>Use fictional test information only. Do not enter real bank account numbers,
        real UPI IDs, card numbers, CVVs, passwords, or OTPs.</p>
        {% if pending_payout %}
            <p><strong>Details locked:</strong> an administrator must resolve your pending payout before you can edit or remove these details.</p>
        {% endif %}
    </article>

    <article class="dashboard-card">
        <h2>{{ "Update simulated details" if details else "Add simulated details" }}</h2>
        <form method="POST" action="{{ url_for('payment_details') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

            <label for="recipient_name">Recipient name</label>
            <input id="recipient_name" name="recipient_name" maxlength="100"
                   required value="{{ details.recipient_name if details else '' }}"
                   {% if pending_payout %}disabled{% endif %}>

            <label for="payment_method">Simulated method</label>
            <select id="payment_method" name="payment_method" required
                    {% if pending_payout %}disabled{% endif %}>
                <option value="">Choose a simulated method</option>
                <option value="upi_simulated" {% if details and details.payment_method == "upi_simulated" %}selected{% endif %}>Simulated UPI reference</option>
                <option value="bank_simulated" {% if details and details.payment_method == "bank_simulated" %}selected{% endif %}>Simulated bank transfer reference</option>
                <option value="wallet_simulated" {% if details and details.payment_method == "wallet_simulated" %}selected{% endif %}>Simulated wallet reference</option>
            </select>

            <label for="recipient_reference">Fictional test reference</label>
            <input id="recipient_reference" name="recipient_reference" maxlength="120"
                   required value="{{ details.recipient_reference if details else '' }}"
                   placeholder="Example: DEMO-RECIPIENT-001"
                   {% if pending_payout %}disabled{% endif %}>

            <p><button class="detail-apply-button" type="submit"
                       {% if pending_payout %}disabled{% endif %}>Save simulated details</button></p>
        </form>

        {% if details %}
            <form method="POST" action="{{ url_for('payment_details') }}"
                  onsubmit="return confirm('Remove your saved simulated payment details?');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="action" value="delete">
                <button class="detail-apply-button" type="submit"
                        {% if pending_payout %}disabled{% endif %}>Remove details</button>
            </form>
            <p class="application-student-email">Last updated: {{ details.updated_at|ist_datetime }}</p>
        {% endif %}
    </article>

    <div class="student-dashboard-return">
        <a class="student-back-dashboard" href="{{ url_for('dashboard') }}">← Back to Dashboard</a>
    </div>
</section>
{% endblock %}
