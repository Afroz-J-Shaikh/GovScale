{% extends "base.html" %}

{% block title %}My Dashboard | GovScale{% endblock %}

{% block content %}
<section class="dashboard-section">

    <h1>Welcome, {{ current_user.full_name }}!</h1>

    <p class="dashboard-intro">
        Discover scholarships, prepare for exams, and keep your opportunities
        in one place.
    </p>

    <div class="dashboard-grid dashboard-stats-grid">
        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon" aria-hidden="true">📄</span>
                <h2>Submitted</h2>
            </div>
            <p class="dashboard-stat">{{ submitted_count }}</p>
            <p>All submissions made</p>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon" aria-hidden="true">🟢</span>
                <h2>Active</h2>
            </div>
            <p class="dashboard-stat">{{ active_count }}</p>
            <p>Submitted, under review, or approved and awaiting payout</p>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon" aria-hidden="true">↩️</span>
                <h2>Withdrawn</h2>
            </div>
            <p class="dashboard-stat">{{ withdrawn_count }}</p>
            <p>Withdrawn by you</p>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon dashboard-emoji-rejected" aria-hidden="true">❌</span>
                <h2>Rejected</h2>
            </div>
            <p class="dashboard-stat">{{ rejected_count }}</p>
            <p>Rejected by the administrator</p>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon" aria-hidden="true">🏆</span>
                <h2>Scholarships Received</h2>
            </div>
            <p class="dashboard-stat">{{ received_count }}</p>
            <p>Successfully paid out</p>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-emoji-icon" aria-hidden="true">💰</span>
                <h2>Total Amount Received</h2>
            </div>
            <p class="dashboard-stat">₹{{ "{:,.2f}".format(received_amount|float) }}</p>
            <p>Total confirmed payouts</p>
        </article>
    </div>

    <div class="dashboard-grid">

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-icon dashboard-icon-grade" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z"/>
                        <path d="M4 17a2.5 2.5 0 0 1 2.5-2.5H20M8 7h7M8 10h5"/>
                    </svg>
                </span>
                <h2>Grade-based</h2>
            </div>
            <p>Scholarships based on academic grades and performance.</p>

            <p class="dashboard-stat">{{ grade_count }}</p>

            <a class="text-link"
               href="{{ url_for('scholarship_category', category='grade') }}">
                Available opportunities →
            </a>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-icon dashboard-icon-exam" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="3" width="14" height="18" rx="2"/>
                        <path d="M9 7h6M9 11h2l1.5 1.5L15 10M9 16h6"/>
                    </svg>
                </span>
                <h2>Exam-based</h2>
            </div>
            <p>Scholarships connected to an examination or assessment.</p>

            <p class="dashboard-stat">{{ exam_count }}</p>

            <a class="text-link"
               href="{{ url_for('scholarship_category', category='exam') }}">
                Available opportunities →
            </a>
        </article>

    </div>

    {% if registered_exam %}
    <div class="dashboard-card exam-countdown-card">
        <span class="section-kicker">YOUR REGISTERED EXAM</span>

        <h2>{{ registered_exam.scholarship.title if registered_exam.scholarship else 'Registered Scholarship Exam' }}</h2>

        <p>
            Scheduled for {{ registered_exam.start_at.strftime("%d %B %Y") }}
            at {{ registered_exam.start_at.strftime("%I:%M %p") }} IST.
        </p>

        <a href="{{ url_for('exam_entry', exam_id=registered_exam.id) }}"
        class="exam-action">
            Start Exam <span aria-hidden="true">→</span>
        </a>
    </div>
    {% endif %}

    <div class="dashboard-grid dashboard-quick-links">
        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-icon dashboard-icon-profile" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 21a8 8 0 0 1 16 0"/>
                    </svg>
                </span>
                <h2>My Profile</h2>
            </div>
            <p>Review your education, institution, and academic details.</p>
            <a class="text-link" href="{{ url_for('student_profile') }}">
                View my profile →
            </a>
        </article>

        
        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-icon dashboard-icon-applications" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 3h7l5 5v13H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/>
                        <path d="M14 3v5h5M9 13h6M9 17h6"/>
                    </svg>
                </span>
                <h2>My Applications</h2>
            </div>
            <p>
                View your submitted scholarship applications and
                check their current status.
            </p>
            <a class="text-link"
               href="{{ url_for('my_applications') }}">
                View my applications →
            </a>
        </article>

        <article class="dashboard-card">
            <div class="dashboard-card-heading">
                <span class="dashboard-icon dashboard-icon-history" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 7v5l3 2M4 5v4h4"/>
                    </svg>
                </span>
                <h2>My History</h2>
            </div>
            <p>Review grade-based applications, exam registrations, results, and answer reviews.</p>
            <a class="text-link" href="{{ url_for('my_history') }}">
                View my history →
            </a>
        </article>
    </div>
</section>


{% endblock %}
