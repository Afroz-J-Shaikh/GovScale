{% extends "admin/base_admin.html" %}
{% block title %}Grade-based | Application History{% endblock %}
{% block admin_content %}
<section class="dashboard-overview">
    <div><span class="dashboard-overview-kicker">GOVSCALE ADMINISTRATION</span><h1>Grade-based Applications</h1><p>Rejected and withdrawn grade-based applications.</p></div>
    <span class="dashboard-overview-mark" aria-hidden="true">📚</span>
</section>
<section class="management-section applications-section">
    <div class="section-heading table-heading"><div><span class="eyebrow"><span class="eyebrow-line"></span> APPLICATION HISTORY</span><h2>Previous decisions</h2></div><div class="table-total"><strong>{{ applications|length }}</strong><span>records</span></div></div>
    <form class="filter-bar" method="GET" action="{{ url_for('admin_grade_application_history') }}">
        <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" name="q" value="{{ search }}" placeholder="Search student or scholarship…" aria-label="Search applications"></label>
        <select name="status" aria-label="Filter decisions"><option value="">All decisions</option><option value="rejected" {% if status_filter == 'rejected' %}selected{% endif %}>Rejected</option><option value="withdrawn" {% if status_filter == 'withdrawn' %}selected{% endif %}>Withdrawn</option></select>
        <button class="filter-button" type="submit">Apply filters</button>
        {% if search or status_filter %}<a class="clear-filters" href="{{ url_for('admin_grade_application_history') }}">Clear</a>{% endif %}
    </form>
    <div class="table-wrap"><div class="admin-table-scroll"><table class="scholarship-table applications-table">
        <thead><tr><th>ID</th><th>STUDENT</th><th>SCHOLARSHIP</th><th>AWARD</th><th>SUBMITTED</th><th>DECISION</th></tr></thead>
        <tbody>{% for application in applications %}<tr>
            <td><span class="application-count">#{{ application.id }}</span></td>
            <td><div class="opportunity-name">{{ application.user.full_name }}</div><div class="application-student-email">{{ application.user.email }}</div></td>
            <td><div class="opportunity-name">{{ application.scholarship.title }}</div></td>
            <td class="amount-cell">₹{{ "{:,}".format(application.scholarship.award_amount) }}</td>
            <td>{% if application.submitted_at %}{{ application.submitted_at.strftime('%d %b %Y, %I:%M %p') }}{% else %}<span class="muted-cell">Not available</span>{% endif %}</td>
            <td><span class="status-pill status-{{ application.status|lower|replace('_', '-') }}"><span></span>{{ application.status|replace('_', ' ')|title }}</span></td>
        </tr>{% else %}<tr><td colspan="6"><div class="empty-state"><strong>No grade-based history found</strong><p>Rejected and withdrawn applications will appear here.</p></div></td></tr>{% endfor %}</tbody>
    </table></div></div>
    <div class="table-footer"><span>Showing {{ applications|length }} records</span><span>History is read-only</span></div>
</section>
{% endblock %}
