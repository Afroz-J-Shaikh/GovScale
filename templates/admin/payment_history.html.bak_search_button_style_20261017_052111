{% extends "admin/base_admin.html" %}

{% block title %}Payment History | GovScale Admin{% endblock %}

{% block admin_content %}
<section class="dashboard-overview">
    <div>
        <span class="dashboard-overview-kicker">GOVSCALE ADMINISTRATION</span>
        <h1>Payment History</h1>
        <p>Read-only records of payouts explicitly confirmed successful by an administrator.</p>
    </div>
</section>

<section class="management-section applications-section">
    <div class="section-heading table-heading">
        <div>
            <span class="eyebrow"><span class="eyebrow-line"></span> COMPLETED PAYOUTS</span>
            <h2>Confirmed payments</h2>
            <p>Includes both grade-based and exam-based scholarships.</p>
        </div>
        <div class="table-total">
            <strong>{{ rewards|length }}</strong>
            <span>confirmed payouts</span>
        </div>
    </div>

    <form class="filter-bar" method="GET"
          action="{{ url_for('admin_payment_history') }}">
        <label class="search-field">
            <span aria-hidden="true">⌕</span>
            <input type="search" name="q" value="{{ search }}"
                   placeholder="Search student or scholarship…"
                   aria-label="Search payment history">
        </label>
        <button class="filter-button" type="submit">Search</button>
        {% if search %}
            <a class="clear-filters"
               href="{{ url_for('admin_payment_history') }}">Clear</a>
        {% endif %}
    </form>

    <div class="table-wrap">
        <div class="admin-table-scroll">
            <table class="scholarship-table applications-table">
                <thead>
                    <tr>
                        <th>STUDENT</th>
                        <th>SCHOLARSHIP</th>
                        <th>TYPE</th>
                        <th>AMOUNT</th>
                        <th>PAYMENT RECORD</th>
                        <th>COMPLETED</th>
                        <th>CONFIRMED BY</th>
                    </tr>
                </thead>
                <tbody>
                {% for reward in rewards %}
                    {% set completed_attempts = reward.attempts
                        |selectattr('status', 'equalto', 'completed')|list %}
                    {% set attempt = completed_attempts[-1] if completed_attempts else none %}
                    <tr>
                        <td>
                            <div class="opportunity-name">{{ reward.user.full_name }}</div>
                            <div class="application-student-email">{{ reward.user.email }}</div>
                            <span class="muted-cell">Application #{{ reward.application_id }}</span>
                        </td>
                        <td>
                            <div class="opportunity-name">{{ reward.scholarship.title }}</div>
                        </td>
                        <td>
                            {{ 'Exam-based' if reward.scholarship.category == 'exam' else 'Grade-based' }}
                        </td>
                        <td class="amount-cell">₹{{ "{:,}".format(reward.amount) }}</td>
                        <td>
                            {% if attempt %}
                                <div>{{ attempt.recipient_name_snapshot }}</div>
                                <div class="application-student-email">
                                    {% if attempt.payment_method_snapshot == 'upi_simulated' %}UPI
                                    {% elif attempt.payment_method_snapshot == 'bank_simulated' %}Bank transfer
                                    {% elif attempt.payment_method_snapshot == 'wallet_simulated' %}Wallet
                                    {% else %}{{ attempt.payment_method_snapshot|replace('_', ' ')|title }}
                                    {% endif %}
                                </div>
                                <div class="application-student-email">
                                    Reference: {{ attempt.recipient_reference_snapshot }}
                                </div>
                            {% else %}
                                <span class="muted-cell">Completed payout recorded</span>
                            {% endif %}
                        </td>
                        <td>
                            <div>{{ reward.completed_at|ist_datetime }}</div>
                            <div style="margin-top: 6px;">
                                <span class="status-pill status-completed"><span></span>Paid</span>
                            </div>
                        </td>
                        <td>
                            {{ reward.completed_by_admin.full_name
                               if reward.completed_by_admin else 'Administrator' }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <strong>No confirmed payments found</strong>
                                <p>Successfully confirmed payouts will appear here.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="table-footer">
        <span>Showing {{ rewards|length }} records</span>
        <span>Read-only history</span>
    </div>
</section>

<div style="display: flex; justify-content: flex-end; margin-top: 20px;">
    <a class="review-button review-approve" href="{{ url_for('admin_rewards') }}">
        Back to Rewards &amp; Payouts
    </a>
</div>
{% endblock %}
