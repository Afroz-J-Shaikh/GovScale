{% extends "admin/base_admin.html" %}

{% block title %}{{ 'Edit' if is_edit else 'Create' }} Scholarship | GovScale Admin{% endblock %}

{% block admin_content %}
<section class="dashboard-overview">
    <div>
        <span class="dashboard-overview-kicker">OPPORTUNITY MANAGEMENT</span>
        <h1>{{ 'Edit Scholarship' if is_edit else 'Create Scholarship' }}</h1>
        <p>Enter the opportunity details that students will see on GovScale.</p>
    </div>
</section>

<section class="management-section scholarship-form-section">
    <form method="POST"
          action="{{ url_for('admin_scholarship_form', scholarship_id=scholarship.id) if is_edit else url_for('admin_scholarship_form') }}"
          class="scholarship-admin-form">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

        <div class="scholarship-form-heading">
            <h2>Scholarship details</h2>
            <p>Fields marked * are required.</p>
        </div>

        <div class="scholarship-form-grid">
            <label class="admin-form-field field-full">
                <span>Scholarship title *</span>
                <input name="title" maxlength="160" required
                       value="{{ request.form.get('title', scholarship.title if scholarship else '') }}"
                       placeholder="e.g. National Merit Scholarship">
            </label>

            <label class="admin-form-field">
                <span>Scholarship category *</span>
                {% set selected_category = request.form.get('category', scholarship.category if scholarship else 'grade') %}
                <select name="category" required>
                    <option value="grade" {% if selected_category == 'grade' %}selected{% endif %}>Grade-based</option>
                    <option value="exam" {% if selected_category == 'exam' %}selected{% endif %}>Exam-based</option>
                </select>
            </label>

            <label class="admin-form-field">
                <span>Award amount (₹) *</span>
                <input type="number" name="award_amount" min="1" step="1" required
                       value="{{ request.form.get('award_amount', scholarship.award_amount if scholarship else '') }}"
                       placeholder="25000">
            </label>

            <label class="admin-form-field">
                <span>Education category</span>
                <input name="education_category" maxlength="30"
                       value="{{ request.form.get('education_category', scholarship.education_category if scholarship else '') }}"
                       placeholder="e.g. school, college, university">
                <small>Optional. Use the category values supported by your student profiles.</small>
            </label>

            <label class="admin-form-field">
                <span>Eligible education levels *</span>
                <input name="eligible_education_levels" maxlength="100" required
                       value="{{ request.form.get('eligible_education_levels', scholarship.eligible_education_levels if scholarship else '') }}"
                       placeholder="e.g. school, college">
                <small>Enter the education levels in the format your eligibility logic expects.</small>
            </label>

            <label class="admin-form-field field-full">
                <span>Description *</span>
                <textarea name="description" rows="4" required
                          placeholder="Explain the scholarship and its purpose">{{ request.form.get('description', scholarship.description if scholarship else '') }}</textarea>
            </label>

            <label class="admin-form-field field-full">
                <span>Eligibility requirements *</span>
                <textarea name="eligibility_description" rows="4" required
                          placeholder="Explain who can apply">{{ request.form.get('eligibility_description', scholarship.eligibility_description if scholarship else '') }}</textarea>
            </label>

            <label class="admin-form-field">
                <span>Application deadline</span>
                <input type="date" name="deadline"
                       value="{{ request.form.get('deadline', scholarship.deadline.isoformat() if scholarship and scholarship.deadline else '') }}">
                <small>Leave blank if there is no deadline.</small>
            </label>
        </div>

        <div class="scholarship-form-actions">
            <a class="clear-filters" href="{{ url_for('admin_scholarships') }}">Cancel</a>
            <button class="scholarship-create-button" type="submit">
                {{ 'Save changes' if is_edit else 'Create Scholarship' }}
            </button>
        </div>
    </form>
</section>
{% endblock %}
