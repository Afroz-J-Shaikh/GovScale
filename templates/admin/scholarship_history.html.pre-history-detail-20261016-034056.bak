{% extends "admin/base_admin.html" %}

{% block title %}Scholarship History | GovScale Admin{% endblock %}

{% block admin_content %}
<section class="dashboard-overview">
    <div>
        <span class="dashboard-overview-kicker">GOVSCALE ADMINISTRATION</span>
        <h1>Scholarship History</h1>
        <p>Read-only records of completed and expired scholarship opportunities, including their eligibility and relevant dates.</p>
    </div>
</section>

<section class="management-section applications-section">
    <div class="section-heading table-heading">
        <div>
            <span class="eyebrow"><span class="eyebrow-line"></span> ARCHIVE</span>
            <h2>Completed and expired scholarships</h2>
            <p>All details are displayed here. Historical records cannot be edited from this page.</p>
        </div>
        <div class="table-heading-actions">
            <div class="table-total">
                <span class="table-total-label">Records</span>
                <strong>{{ history_rows|length }}</strong>
            </div>
        </div>
    </div>

    <form class="filter-bar" method="GET"
          action="{{ url_for('admin_scholarship_history') }}">
        <label class="search-field">
            <span aria-hidden="true">⌕</span>
            <input type="search" name="q" value="{{ search }}"
                   placeholder="Search scholarships…"
                   aria-label="Search scholarships">
        </label>

        <select name="category" aria-label="Filter by category">
            <option value="">All categories</option>
            <option value="grade" {% if category_filter == 'grade' %}selected{% endif %}>Grade-based</option>
            <option value="exam" {% if category_filter == 'exam' %}selected{% endif %}>Exam-based</option>
        </select>

        <select name="status" aria-label="Filter by lifecycle status">
            <option value="">Completed and expired</option>
            <option value="completed" {% if status_filter == 'completed' %}selected{% endif %}>Completed</option>
            <option value="expired" {% if status_filter == 'expired' %}selected{% endif %}>Expired</option>
        </select>

        <button class="filter-button" type="submit">Apply filters</button>
        {% if search or category_filter or status_filter %}
        <a class="clear-filters"
           href="{{ url_for('admin_scholarship_history') }}">Clear</a>
        {% endif %}
    </form>

    <div class="table-wrap history-table-wrap">
        <div class="admin-table-scroll">
        <table class="scholarship-table history-table">
            <thead>
                <tr>
                    <th>SCHOLARSHIP</th>
                    <th>CATEGORY</th>
                    <th>AWARD AMOUNT</th>
                    <th>DESCRIPTION</th>
                    <th>EDUCATION</th>
                    <th>DEADLINE / EXAM SCHEDULE</th>
                    <th>FINAL STATUS</th>
                </tr>
            </thead>
            <tbody>
                {% for scholarship, exam in history_rows %}
                <tr>
                    <td class="history-scholarship-cell">
                        <div class="opportunity-name">{{ scholarship.title }}</div>
                        <div class="application-student-email">Scholarship ID #{{ scholarship.id }}</div>
                    </td>
                    <td>
                        <div class="history-category">
                            {{ 'Grade-based' if scholarship.category == 'grade' else 'Exam-based' }}
                        </div>
                    </td>
                    <td>
                        <div class="history-award">
                            {% if scholarship.award_amount is not none %}
                                ₹{{ "{:,}".format(scholarship.award_amount) }}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </td>
                    <td class="history-detail-cell">
                        <p>{{ scholarship.description or 'No description recorded.' }}</p>
                    </td>
                    <td class="history-detail-cell">
                        <p>{{ (scholarship.eligible_education_levels or scholarship.education_category or 'Not specified')|replace('_', ' ')|replace(',', ', ')|title }}</p>
                    </td>
                    <td class="history-detail-cell history-date-cell">
                        {% if scholarship.category == 'grade' %}
                            <strong>Application deadline</strong>
                            <p>
                                {% if scholarship.deadline %}
                                    {{ scholarship.deadline.strftime('%d %b %Y') }}
                                {% else %}
                                    Not specified
                                {% endif %}
                            </p>
                        {% else %}
                            {% if exam %}
                                {% if exam.description %}
                                    <strong>Exam details</strong>
                                    <p>{{ exam.description }}</p>
                                {% endif %}
                                <strong>Registration opens</strong>
                                <p>
                                    {{ exam.registration_opens_at.strftime('%d %b %Y, %I:%M %p') if exam.registration_opens_at else 'Not specified' }}
                                </p>
                                <strong>Exam starts</strong>
                                <p>
                                    {{ exam.start_at.strftime('%d %b %Y, %I:%M %p') if exam.start_at else 'Not specified' }}
                                </p>
                                <strong>Exam ends</strong>
                                <p>
                                    {{ exam.end_at.strftime('%d %b %Y, %I:%M %p') if exam.end_at else 'Not specified' }}
                                </p>
                            {% else %}
                                <p>No linked exam schedule recorded.</p>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td>
                        <span class="status-pill {% if scholarship.lifecycle_status == 'completed' %}status-approved{% else %}status-rejected{% endif %}">
                            <span></span>{{ scholarship.lifecycle_status|title }}
                        </span>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            <div class="empty-state-icon" aria-hidden="true">🗂️</div>
                            <strong>No historical scholarships found</strong>
                            <p>Completed or expired scholarships will appear here. Try changing your search or filters.</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
</section>
{% endblock %}
