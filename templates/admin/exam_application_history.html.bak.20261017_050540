{% extends "admin/base_admin.html" %}
{% block title %}Exam-based | Application History{% endblock %}
{% block admin_content %}
<section class="dashboard-overview">
    <div><span class="dashboard-overview-kicker">GOVSCALE ADMINISTRATION</span><h1>Exam-based Applications</h1><p>Historical exam registrations and submitted pass/fail results.</p></div>
    <span class="dashboard-overview-mark" aria-hidden="true">📝</span>
</section>
<section class="management-section applications-section">
    <div class="section-heading table-heading"><div><span class="eyebrow"><span class="eyebrow-line"></span> APPLICATION HISTORY</span><h2>Exam results and registrations</h2></div><div class="table-total"><strong>{{ registrations|length }}</strong><span>records</span></div></div>
    <form class="filter-bar" method="GET" action="{{ url_for('admin_exam_application_history') }}">
        <label class="search-field"><span aria-hidden="true">⌕</span><input type="search" name="q" value="{{ search }}" placeholder="Search student, exam, or scholarship…" aria-label="Search exam history"></label>
        <button class="filter-button" type="submit">Search</button>
        {% if search %}<a class="clear-filters" href="{{ url_for('admin_exam_application_history') }}">Clear</a>{% endif %}
    </form>
    <div class="table-wrap"><div class="admin-table-scroll"><table class="scholarship-table applications-table">
        <thead><tr><th>ID</th><th>STUDENT</th><th>EXAM</th><th>LINKED SCHOLARSHIP</th><th>REGISTERED</th><th>RESULT</th><th>STATUS</th></tr></thead>
        <tbody>{% for registration in registrations %}{% set submission = submissions.get(registration.id) %}<tr>
            <td><span class="application-count">#{{ registration.id }}</span></td>
            <td><div class="opportunity-name">{{ registration.user.full_name }}</div><div class="application-student-email">{{ registration.user.email }}</div></td>
            <td><div class="opportunity-name">{{ registration.exam.title }}</div></td>
            <td>{% if registration.exam.scholarship %}<div class="opportunity-name">{{ registration.exam.scholarship.title }}</div>{% else %}<span class="muted-cell">Not linked</span>{% endif %}</td>
            <td>{% if registration.registered_at %}{{ registration.registered_at.strftime('%d %b %Y, %I:%M %p') }}{% else %}<span class="muted-cell">Not available</span>{% endif %}</td>
            <td>{% if submission %}<strong>{% if submission.passed %}Passed{% else %}Failed{% endif %}</strong>{% if submission.percentage is not none %}<div class="application-student-email">{{ "%.1f"|format(submission.percentage) }}%</div>{% endif %}{% else %}<span class="muted-cell">No submitted result</span>{% endif %}</td>
            <td><span class="status-pill"><span></span>{{ registration.status|replace('_', ' ')|title }}</span></td>
        </tr>{% else %}<tr><td colspan="7"><div class="empty-state"><strong>No exam history found</strong><p>Historical exam records will appear here.</p></div></td></tr>{% endfor %}</tbody>
    </table></div></div>
    <div class="table-footer"><span>Showing {{ registrations|length }} records</span><span>Eligible passed applications appear in Rewards &amp; Payouts</span></div>
</section>
{% endblock %}
