{% extends "base.html" %}

{% block title %}Exam Result | GovScale{% endblock %}

{% block content %}
<section class="dashboard-section">
    <div class="dashboard-card exam-lobby-card">
        <span class="section-kicker">EXAM RESULT</span>
        <h1>{{ exam.scholarship.title if exam.scholarship else exam.title }}</h1>
        <p>Your submission has been recorded.</p>

        <p><strong>Score:</strong> {{ submission.score }} / {{ submission.total_marks }}</p>
        <p><strong>Percentage:</strong> {{ "%.2f"|format(submission.percentage) }}%</p>
        <p><strong>Passing threshold:</strong> {{ "%.2f"|format(submission.passing_threshold) }}%</p>
        <p><strong>Status:</strong> {{ "Passed" if submission.passed else "Not passed" }}</p>
        <p><strong>Submitted at:</strong> {{ submission.submitted_at.strftime("%d %b %Y, %I:%M:%S %p") }}</p>
    </div>

    <section class="dashboard-card" aria-labelledby="answer-review-title">
        <span class="section-kicker">DETAILED FEEDBACK</span>
        <h2 id="answer-review-title">Answer Review</h2>

        {% for item in answer_review %}
        <article class="exam-history-item">
            <h3>Question {{ loop.index }}: {{ item.question_text }}</h3>
            <p>
                <strong>Your answer:</strong>
                {% if item.selected_option %}
                    {{ item.selected_option }}. {{ item.selected_text }}
                {% else %}
                    {{ item.selected_text }}
                {% endif %}
            </p>
            <p><strong>Correct answer:</strong> {{ item.correct_option }}. {{ item.correct_text }}</p>
            <p>
                <strong>Outcome:</strong>
                {% if item.is_correct %}
                    Correct
                {% else %}
                    Incorrect
                {% endif %}
            </p>
            <p><strong>Marks:</strong> {{ item.awarded_marks }} / {{ item.marks }}</p>
        </article>
        {% else %}
        <p>No answer details are available for this submission.</p>
        {% endfor %}
    </section>

    <a href="{{ url_for('dashboard') }}" class="exam-action">← Back to dashboard</a>
</section>
{% endblock %}
