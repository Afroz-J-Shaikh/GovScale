/* Small celebratory bursts are only rendered for passing results. */
.result-celebration {
    position: absolute;
    inset: -10px 0 auto;
    height: 150px;
    overflow: hidden;
    pointer-events: none;
}

.result-firework,
.result-sparkle {
    position: absolute;
    display: block;
    font-size: 2rem;
    opacity: 0;
    animation: exam-result-firework 1.25s ease-out both;
}

.firework-one {
    left: 17%;
    top: 25px;
    color: #e8b931;
    animation-delay: 0.05s;
}

.firework-two {
    right: 18%;
    top: 12px;
    color: #24a878;
    animation-delay: 0.22s;
}

.firework-three {
    left: 49%;
    top: 2px;
    color: #e8b931;
    animation-delay: 0.38s;
}

.sparkle-one {
    left: 30%;
    top: 65px;
    color: #24a878;
    animation-delay: 0.18s;
}

.sparkle-two {
    right: 30%;
    top: 55px;
    color: #e8b931;
    animation-delay: 0.32s;
}

@keyframes exam-result-firework {
    0% {
        opacity: 0;
        transform: scale(0.15) rotate(0deg);
    }
    35% {
        opacity: 1;
        transform: scale(1.35) rotate(45deg);
    }
    100% {
        opacity: 0;
        transform: scale(0.8) rotate(90deg);
    }
}

@media (prefers-reduced-motion: reduce) {
    .result-firework,
    .result-sparkle {
        animation: none;
        opacity: 0;
    }
}\n

