    line-height: 1.7;
}

.no-results {
    padding: 20px;
    border-radius: 10px;
    background: var(--gs-ivory);
    color: var(--gs-muted);
}

/* How it works */
.how-section-redesign {
    padding: 78px clamp(6%, calc((100% - 1180px) / 2), 10%);
    background: var(--gs-ivory);
}

.how-heading {
    max-width: 720px;
