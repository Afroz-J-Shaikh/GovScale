
:root {
    --green: #244E3B;
    --sage: #6D9477;
    --gold: #D9A441;
    --ivory: #F7F3E9;
    --white: #FFFFFF;
    --text: #252B27;
    --muted: #62685E;
    --border: #D9DED8;
    --error: #B84040;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    margin: 0;
    background: var(--ivory);
    color: var(--text);
    font-family: Inter, "Segoe UI", Arial, sans-serif;
    line-height: 1.6;
}

[hidden] {
    display: none !important;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select {
    font: inherit;
}

.navbar {
    min-height: 78px;
    padding: 15px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: var(--ivory);
    border-bottom: 1px solid rgba(36, 78, 59, 0.12);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--green);
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.7px;
}

.brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--green);
    color: white;
    font-size: 20px;
}

.nav-links,
.nav-actions {
    display: flex;
    align-items: center;
    gap: 24px;
}

.nav-links a,
.nav-login {
    color: var(--muted);
    font-size: 13px;
    font-weight: 650;
}

.nav-links a:hover,
.nav-login:hover,
.text-link:hover {
    color: var(--sage);
}

.nav-actions {
    gap: 15px;
}

.nav-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 17px;
    border: 1px solid var(--green);
    border-radius: 7px;
    background: var(--green);
    color: white;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.nav-button:hover {
    background: #183D2B;
}

.logout-form {
    margin: 0;
}

.hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 65px;
    padding: 75px 9%;
}

.hero-content {
    max-width: 590px;
}

.eyebrow,
.section-kicker {
    color: var(--sage);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.6px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
}

.hero h1 {
    margin: 24px 0 18px;
    color: var(--green);
    font-size: clamp(43px, 5vw, 65px);
    line-height: 1.1;
    letter-spacing: -2.8px;
}

.hero h1 span {
    color: var(--sage);
}

.hero-description {
    max-width: 490px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.9;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 27px;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 19px;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
}

.button-primary {
    background: var(--green);
    color: white;
}

.button-primary:hover {
    background: #183D2B;
}

.button-secondary {
    border-color: #BFCDBE;
    background: transparent;
    color: var(--green);
}

.button-secondary:hover {
    background: #E9EDE4;
}

.audience-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 25px;
    color: var(--muted);
    font-size: 11px;
}

.hero-panel {
    padding: 29px;
    border: 1px solid #E0E4DB;
    border-radius: 16px;
    background: white;
    box-shadow: 0 18px 50px rgba(36, 78, 59, 0.07);
}

.panel-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.panel-star {
    color: var(--gold);
    font-size: 23px;
}

.hero-emblem {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin: 26px 0 20px;
    border-radius: 18px;
    background: #E7EEE3;
    color: var(--green);
    font-size: 34px;
    font-weight: 750;
}

.hero-panel h2 {
    margin: 0 0 9px;
    color: var(--green);
    font-size: 25px;
    line-height: 1.35;
    letter-spacing: -0.5px;
}

.hero-panel > p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
}

.panel-divider {
    height: 1px;
    margin: 23px 0 15px;
    background: var(--border);
}

.panel-feature {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 10px 0;
}

.feature-icon,
.dashboard-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 39px;
    height: 39px;
    border-radius: 10px;
    background: #E7EEE3;
    color: var(--green);
    font-size: 21px;
}

.panel-feature div {
    display: grid;
}

.panel-feature strong {
    color: var(--green);
    font-size: 12px;
}

.panel-feature small {
    color: var(--muted);
    font-size: 11px;
}

.catalog-section {
    padding: 75px 9%;
    background: rgba(255, 255, 255, 0.48);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
}

.section-heading h2,
.how-section h2 {
    margin: 8px 0;
    color: var(--green);
    font-size: clamp(26px, 3vw, 35px);
    line-height: 1.3;
    letter-spacing: -0.8px;
}

.section-heading p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
}

.demo-label {
    padding: 6px 10px;
    border: 1px solid #D7C18C;
    border-radius: 5px;
    color: #795719;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    white-space: nowrap;
}

.search-panel {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(150px, 1fr);
    gap: 8px 15px;
    align-items: center;
    margin-bottom: 27px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: white;
}

.search-panel label {
    color: var(--green);
    font-size: 11px;
    font-weight: 700;
}

.search-panel input,
.search-panel select {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid #C9D1C7;
    border-radius: 6px;
    background: white;
    color: var(--text);
    font-size: 12px;
}

.search-panel input:focus,
.search-panel select:focus,
.form-input:focus {
    outline: 2px solid #6D9477;
    outline-offset: 2px;
}

.search-status {
    grid-column: 1 / -1;
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 11px;
}

.scholarship-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.scholarship-card,
.dashboard-card {
    padding: 23px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: white;
}

.scholarship-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.scholarship-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(36, 78, 59, 0.07);
}

.scholarship-symbol {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    margin-bottom: 18px;
    border-radius: 11px;
    font-size: 22px;
}

.symbol-green {
    background: #E5EEE2;
    color: var(--green);
}

.symbol-gold {
    background: #F7EBCB;
    color: #795719;
}

.symbol-sage {
    background: #E7EAE1;
    color: #61795F;
}

.type-label {
    color: var(--sage);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.9px;
}

.scholarship-card h3 {
    margin: 9px 0;
    color: var(--green);
    font-size: 17px;
    line-height: 1.4;
}

.scholarship-card > p {
    min-height: 78px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.scholarship-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 16px 0;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
}

.scholarship-meta strong {
    color: var(--green);
    font-size: 21px;
}

.text-link {
    color: var(--green);
    font-size: 12px;
    font-weight: 750;
}

.demo-disclaimer {
    margin-top: 24px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
}

.no-results {
    padding: 20px;
    border: 1px dashed var(--border);
    border-radius: 8px;
    color: var(--muted);
    text-align: center;
    font-size: 13px;
}

.how-section {
    padding: 75px 9%;
}

.steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 36px;
}

.step {
    padding-top: 18px;
    border-top: 1px solid #C8D2C5;
}

.step-number {
    color: var(--sage);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

.step h3 {
    margin: 12px 0 5px;
    color: var(--green);
    font-size: 15px;
}

.step p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.auth-section {
    display: flex;
    justify-content: center;
    padding: 55px 20px 70px;
}

.auth-card {
    width: 100%;
    max-width: 500px;
    padding: 34px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: white;
    box-shadow: 0 14px 40px rgba(36, 78, 59, 0.06);
}

.back-link {
    display: inline-block;
    margin-bottom: 27px;
    color: var(--muted);
    font-size: 12px;
}

.auth-card h1 {
    margin: 8px 0 10px;
    color: var(--green);
    font-size: 30px;
    line-height: 1.25;
    letter-spacing: -0.8px;
}

.auth-intro {
    margin: 0 0 25px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
}

.form-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 17px;
}

.form-field label {
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
}

.form-input {
    width: 100%;
    padding: 12px;
    border: 1px solid #C9D1C7;
    border-radius: 7px;
    background: white;
    color: var(--text);
    font-size: 13px;
}

.checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 20px 0 8px;
    color: var(--text);
    font-size: 12px;
}

.checkbox-row input {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    accent-color: var(--green);
}

.form-note {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
}

.field-error {
    color: var(--error);
    font-size: 11px;
}

.auth-submit {
    width: 100%;
    margin-top: 12px;
}

.auth-switch {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
}

.auth-switch a {
    color: var(--green);
    font-weight: 750;
}

.alert {
    margin: 12px 0;
    padding: 11px 13px;
    border-radius: 7px;
    font-size: 12px;
}

.alert-success {
    background: #E5EEE2;
    color: #244E3B;
}

.alert-error {
    background: #FBE8E5;
    color: #8B2F2F;
}

.flash-container {
    max-width: 850px;
    margin: 16px auto 0;
    padding: 0 20px;
}

.dashboard-section {
    min-height: 65vh;
    padding: 55px 9% 80px;
}

.dashboard-section > h1 {
    margin: 8px 0;
    color: var(--green);
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -1px;
}

.dashboard-intro {
    color: var(--muted);
    font-size: 14px;
}

.profile-summary {
    display: flex;
    align-items: center;
    gap: 17px;
    margin: 28px 0;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: white;
}

.profile-avatar {
    display: grid;
    place-items: center;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #E5EEE2;
    color: var(--green);
    font-size: 23px;
    font-weight: 800;
}

.profile-summary h2 {
    margin: 0;
    color: var(--green);
    font-size: 17px;
}

.profile-summary p {
    margin: 2px 0;
    color: var(--muted);
    font-size: 12px;
}

.profile-level {
    color: var(--sage);
    font-size: 11px;
    font-weight: 700;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.dashboard-card h2 {
    margin: 17px 0 8px;
    color: var(--green);
    font-size: 17px;
}

.dashboard-card p {
    min-height: 62px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

.coming-soon {
    color: #795719;
    font-size: 10px;
    font-weight: 750;
}

.footer {
    padding: 30px 9%;
    border-top: 1px solid var(--border);
}

.footer-brand {
    font-size: 18px;
}

.footer-brand .brand-mark {
    width: 30px;
    height: 30px;
    font-size: 16px;
}

.footer p,
.footer small {
    color: var(--muted);
    font-size: 11px;
}

.footer small {
    font-size: 10px;
}

@media (max-width: 850px) {
    .navbar {
        padding: 14px 5%;
        gap: 14px;
    }

    .nav-links {
        gap: 13px;
    }

    .hero {
        gap: 30px;
        padding: 55px 6%;
    }

    .catalog-section,
    .how-section,
    .dashboard-section {
        padding-left: 6%;
        padding-right: 6%;
    }

    .scholarship-grid,
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .navbar {
        flex-wrap: wrap;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: flex-start;
    }

    .nav-actions {
        gap: 10px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 43px 6%;
    }

    .hero h1 {
        font-size: 46px;
        letter-spacing: -1.8px;
    }

    .hero-panel {
        padding: 23px;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .search-panel,
    .scholarship-grid,
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .scholarship-card > p,
    .dashboard-card p {
        min-height: 0;
    }

    .steps-grid {
        gap: 20px;
    }

    .auth-card {
        padding: 24px;
    }

    .auth-card h1 {
        font-size: 26px;
    }

    .footer {
        padding: 28px 6%;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition: none !important;
    }
}

/* =========================================
   GOVSCALE BRAND REFRESH
   Botanical Green + Warm Ivory
   ========================================= */

:root {
    --brand-green: #244E3B;
    --brand-sage: #6D9477;
    --brand-gold: #D9A441;
    --brand-ivory: #F7F3E9;
    --brand-white: #FFFFFF;
    --brand-charcoal: #252B27;
    --brand-muted: #62685E;
    --brand-border: #D9DED8;
}

body {
    color: var(--brand-charcoal);
    background: var(--brand-ivory);
    font-size: 16px;
    line-height: 1.65;
}

.site-header {
    position: relative;
    z-index: 10;
    background: var(--brand-white);
    border-bottom: 1px solid var(--brand-border);
}

.navbar {
    width: min(1200px, calc(100% - 48px));
    min-height: 92px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--brand-green);
    text-decoration: none;
    flex-shrink: 0;
}

.brand-emblem {
    width: 54px;
    height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-ivory);
    background: var(--brand-green);
    border-radius: 50%;
    flex-shrink: 0;
}

.brand-emblem svg {
    width: 43px;
    height: 43px;
}

.brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
}

.brand-name {
    font-size: 25px;
    font-weight: 750;
    letter-spacing: -0.6px;
}

.brand-tagline {
    margin-top: 4px;
    color: var(--brand-muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1px;
}

.nav-links,
.nav-actions {
    display: flex;
    align-items: center;
    gap: 22px;
}

.nav-links a,
.nav-login,
.nav-dashboard {
    color: var(--brand-charcoal);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
}

.nav-links a:hover,
.nav-login:hover,
.nav-dashboard:hover {
    color: var(--brand-sage);
}

.nav-actions {
    gap: 16px;
    flex-shrink: 0;
}

.nav-signup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 19px;
    color: var(--brand-white);
    background: var(--brand-green);
    border: 1px solid var(--brand-green);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
}

.nav-signup:hover {
    color: var(--brand-white);
    background: #193B2B;
    transform: translateY(-1px);
}

.nav-logout-form {
    margin: 0;
}

.nav-logout {
    padding: 9px 13px;
    color: var(--brand-green);
    background: transparent;
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}

.nav-logout:hover {
    background: var(--brand-ivory);
}

.flash-container {
    width: min(1000px, calc(100% - 40px));
    margin: 18px auto;
}

.flash-message {
    margin-bottom: 10px;
    padding: 13px 16px;
    border: 1px solid var(--brand-border);
    border-radius: 8px;
    background: var(--brand-white);
    font-size: 15px;
}

.site-footer {
    margin-top: 64px;
    padding: 40px 24px 28px;
    color: var(--brand-ivory);
    background: var(--brand-green);
}

.footer-inner {
    width: min(1100px, 100%);
    margin: 0 auto;
    text-align: center;
}

.footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-ivory);
    font-size: 23px;
    font-weight: 750;
    text-decoration: none;
}

.footer-brand-emblem {
    width: 36px;
    height: 36px;
    display: inline-flex;
}

.footer-brand-emblem svg {
    width: 100%;
    height: 100%;
}

.footer-tagline {
    margin: 12px 0;
    color: var(--brand-ivory);
    font-size: 15px;
}

.footer-disclaimer,
.footer-copyright {
    max-width: 720px;
    margin: 10px auto 0;
    color: #E0E8DF;
    font-size: 13px;
}

.footer-copyright {
    margin-top: 20px;
}

/* Responsive navigation */
@media (max-width: 1050px) {
    .navbar {
        width: calc(100% - 32px);
        flex-wrap: wrap;
        justify-content: space-between;
        padding: 16px 0;
        gap: 16px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px 24px;
    }

    .nav-actions {
        margin-left: auto;
    }
}

@media (max-width: 600px) {
    .navbar {
        width: calc(100% - 28px);
        gap: 14px;
    }

    .brand-emblem {
        width: 46px;
        height: 46px;
    }

    .brand-emblem svg {
