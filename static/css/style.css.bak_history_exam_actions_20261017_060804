/* =========================================================
   GOVSCALE HOMEPAGE REDESIGN
   Botanical green, warm ivory, larger typography
   ========================================================= */

:root {
    --gs-green: #244E3B;
    --gs-green-dark: #193A2B;
    --gs-sage: #6D9477;
    --gs-gold: #D9A441;
    --gs-ivory: #F7F3E9;
    --gs-paper: #FFFDF8;
    --gs-ink: #252B27;
    --gs-muted: #667169;
    --gs-border: #E2E5DA;
}

/* Header and footer intentionally share the same background */
.site-header,
.site-footer {
    background: var(--gs-green) !important;
    color: var(--gs-paper);
}

.site-header {
    border-bottom: 1px solid rgba(255,255,255,0.14);
}

.site-header a,
.site-footer a {
    color: var(--gs-paper);
}

.site-header a:hover,
.site-footer a:hover {
    color: #E8C778;
}

.site-header .nav-signup,
.site-header .nav-login {
    border-color: rgba(255,255,255,0.65);
}

.site-header .nav-signup {
    background: var(--gs-paper);
    color: var(--gs-green);
}

.site-header .nav-signup:hover {
    background: #E8C778;
    color: var(--gs-green-dark);
}

/* Shared typography */
body {
    color: var(--gs-ink);
    font-size: 18px;
    line-height: 1.75;
}

p {
    line-height: 1.8;
}

.hero-redesign {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    align-items: center;
    gap: clamp(36px, 6vw, 88px);
    overflow: hidden;
    padding: clamp(64px, 8vw, 112px) clamp(6%, calc((100% - 1240px) / 2), 10%);
    background:
        radial-gradient(ellipse at 88% 15%, rgba(217,164,65,0.15), transparent 36%),
        var(--gs-ivory);
}

.hero-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
}

.hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    color: var(--gs-green);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1.6px;
}

.hero-label-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    border-radius: 50%;
    background: var(--gs-gold);
}

.hero-redesign h1 {
    margin: 0 0 24px;
    color: var(--gs-green-dark);
    font-size: clamp(54px, 5.3vw, 76px);
    font-weight: 800;
    letter-spacing: -2.4px;
    line-height: 1.12;
}

.hero-redesign h1 span {
    color: var(--gs-sage);
}

.hero-redesign .hero-description {
    max-width: 650px;
    margin-bottom: 30px;
    color: #515D54;
    font-size: 20px;
    line-height: 1.8;
}

.hero-redesign .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
}

.hero-redesign .button {
    min-height: 52px;
    padding: 14px 22px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
}

.hero-redesign .button-primary {
    border: 1px solid var(--gs-green);
    background: var(--gs-green);
    color: white;
}

.hero-redesign .button-primary:hover {
    background: var(--gs-green-dark);
}

.hero-redesign .button-secondary {
    border: 1px solid #B7C6B7;
    background: transparent;
    color: var(--gs-green);
}

.hero-redesign .button-secondary:hover {
    background: #E8EDE4;
}

.hero-redesign .audience-note {
    margin-top: 22px;
    color: var(--gs-muted);
    font-size: 15px;
}

/* Decorative hero panel: no image required */
.hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 430px;
    isolation: isolate;
}

.visual-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid rgba(109,148,119,0.36);
    border-radius: 50%;
    aspect-ratio: 1;
}

.orbit-one {
    width: 410px;
    max-width: 100%;
}

.orbit-two {
    width: 330px;
    max-width: 85%;
    border-style: dashed;
}

.visual-card {
    width: min(100%, 390px);
    padding: 30px;
    border: 1px solid rgba(255,255,255,0.9);
    border-radius: 22px;
    background: rgba(255,253,248,0.96);
    box-shadow: 0 24px 70px rgba(36,78,59,0.13);
}

.visual-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.visual-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 13px;
    background: #E7EEE5;
    color: var(--gs-green);
    font-size: 24px;
}

.visual-status,
.visual-small-heading {
    color: var(--gs-muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.visual-small-heading {
    margin: 26px 0 8px;
    font-size: 12px;
    letter-spacing: 0.5px;
}

.visual-card h2 {
    margin: 0;
    color: var(--gs-green-dark);
    font-size: 30px;
    line-height: 1.25;
}

.visual-description {
    margin: 12px 0 20px;
    color: var(--gs-muted);
    font-size: 15px;
}

.visual-divider {
    height: 1px;
    margin-bottom: 16px;
    background: var(--gs-border);
}

.visual-feature {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 10px 0;
}

.visual-feature-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 11px;
    background: #F0E8D4;
    color: var(--gs-green);
    font-size: 13px;
    font-weight: 800;
}

.visual-feature strong,
.visual-feature small {
    display: block;
}

.visual-feature strong {
    color: var(--gs-ink);
    font-size: 15px;
}

.visual-feature small {
    color: var(--gs-muted);
    font-size: 13px;
}

.visual-decoration {
    position: absolute;
    color: var(--gs-gold);
    line-height: 1;
}

.visual-decoration-one {
    top: 28px;
    right: 8%;
    font-size: 42px;
}

.visual-decoration-two {
    bottom: 26px;
    left: 5%;
    font-size: 32px;
}

/* Upcoming exam and countdown */
.exam-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
    align-items: center;
    gap: 44px;
    padding: 64px clamp(6%, calc((100% - 1180px) / 2), 10%);
