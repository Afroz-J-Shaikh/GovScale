}

.exam-copy > p {
    max-width: 650px;
    margin-bottom: 24px;
    color: rgba(255,255,255,0.8);
    font-size: 16px;
}

.exam-date {
    display: flex;
    align-items: center;
    gap: 14px;
}

.exam-calendar-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 12px;
    background: rgba(255,255,255,0.12);
    color: #E8C778;
    font-size: 26px;
}

.exam-date strong,
.exam-date small {
    display: block;
}

.exam-date strong {
    color: white;
    font-size: 17px;
}

.exam-date small {
    color: rgba(255,255,255,0.72);
    font-size: 13px;
}

.countdown-panel {
    padding: 28px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 18px;
    background: rgba(255,255,255,0.08);
}

.countdown-heading {
    display: block;
    margin-bottom: 22px;
    color: #E8C778;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.countdown-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
}

.countdown-unit {
    padding: 17px 5px;
    border-radius: 12px;
    background: var(--gs-paper);
    text-align: center;
}

.countdown-unit strong,
.countdown-unit span {
    display: block;
}

.countdown-unit strong {
    color: var(--gs-green);
    font-size: clamp(24px, 3vw, 36px);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
}

.countdown-unit span {
    margin-top: 7px;
    color: var(--gs-muted);
    font-size: 12px;
}

.countdown-message {
    margin: 16px 0 0;
    color: rgba(255,255,255,0.76);
    font-size: 13px;
}

/* Scholarship catalog */
.catalog-section {
    padding: 80px clamp(6%, calc((100% - 1180px) / 2), 10%);
    background: var(--gs-paper);
}

.section-heading {
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
}

.section-kicker {
    display: inline-block;
    color: var(--gs-sage);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.section-heading h2,
.how-heading h2 {
    margin: 10px 0 8px;
    color: var(--gs-green-dark);
    font-size: clamp(32px, 3.4vw, 43px);
    line-height: 1.25;
}

.section-heading p,
.how-heading > p {
    color: var(--gs-muted);
    font-size: 17px;
}

.demo-label {
    padding: 8px 12px;
    border: 1px solid #E7D8B7;
    border-radius: 30px;
    background: #F8F0DF;
    color: #785A20;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
}

.search-panel-redesign {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 0.65fr);
    gap: 18px 24px;
    align-items: end;
    margin-bottom: 32px;
    padding: 24px;
    border: 1px solid var(--gs-border);
    border-radius: 16px;
    background: var(--gs-ivory);
}

.search-panel-redesign .search-field label {
    display: block;
    margin-bottom: 8px;
    color: var(--gs-ink);
    font-size: 15px;
    font-weight: 700;
}

.search-panel-redesign input,
.search-panel-redesign select {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 1px solid #D3DBD0;
    border-radius: 9px;
    background: white;
    color: var(--gs-ink);
    font: inherit;
    font-size: 16px;
}

.search-panel-redesign input:focus,
.search-panel-redesign select:focus {
    outline: 3px solid rgba(109,148,119,0.25);
    border-color: var(--gs-sage);
}

.search-panel-redesign .search-status {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--gs-muted);
    font-size: 14px;
}

.scholarship-grid-redesign {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.scholarship-card-redesign {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 27px;
    border: 1px solid var(--gs-border);
    border-radius: 16px;
    background: white;
    box-shadow: 0 8px 25px rgba(36,78,59,0.04);
    transition: transform 180ms ease, box-shadow 180ms ease,
                border-color 180ms ease;
}

.scholarship-card-redesign:hover {
    transform: translateY(-4px);
    border-color: #B9CBB8;
    box-shadow: 0 15px 35px rgba(36,78,59,0.10);
}

.card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
}

.card-top-row .scholarship-symbol {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 13px;
    font-size: 25px;
}

.symbol-green {
    background: #E7EEE5;
    color: var(--gs-green);
}

.symbol-gold {
    background: #F8F0DF;
    color: #8A6723;
}

.symbol-sage {
    background: #EAF0E9;
    color: #4C7657;
}

.scholarship-card-redesign .type-label {
    color: var(--gs-green);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-align: right;
}

.scholarship-card-redesign h3 {
    margin: 0 0 12px;
    color: var(--gs-green-dark);
    font-size: 23px;
    line-height: 1.4;
}

.scholarship-card-redesign > p {
    flex: 1;
    margin-bottom: 24px;
    color: var(--gs-muted);
    font-size: 16px;
    line-height: 1.8;
}

.scholarship-card-redesign .scholarship-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 17px 0;
