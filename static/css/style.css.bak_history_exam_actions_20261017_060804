}

.scholarship-card-redesign .scholarship-meta span {
    color: var(--gs-muted);
    font-size: 13px;
}

.scholarship-card-redesign .scholarship-meta strong {
    color: var(--gs-green);
    font-size: 23px;
    white-space: nowrap;
}

.scholarship-card-redesign .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 5px;
    color: var(--gs-green);
