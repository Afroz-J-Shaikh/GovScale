/* EXAM QUESTION MANAGEMENT BUTTON CONSISTENCY */
.exam-question-management .exam-question-management-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
}

.exam-question-management .exam-question-management-actions > .review-button,
.exam-question-management .exam-question-management-actions > .scholarship-create-button,
.exam-question-management .exam-question-management-actions > a.clear-filters {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    margin: 0;
    padding: 0 13px;
    border: 1px solid var(--admin-green);
    border-radius: 7px;
    background: var(--admin-green);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
}

.exam-question-management .exam-question-management-actions > .review-button:hover,
.exam-question-management .exam-question-management-actions > .scholarship-create-button:hover,
.exam-question-management .exam-question-management-actions > a.clear-filters:hover {
    border-color: var(--admin-green-dark);
    background: var(--admin-green-dark);
    color: #fff;
}

.exam-question-management .exam-question-management-actions > .review-button.review-reject {
    border-color: #B42318;
    background: #B42318;
    color: #fff;
}

.exam-question-management .exam-question-management-actions > .review-button.review-reject:hover {
    border-color: #912018;
    background: #912018;
    color: #fff;
}

.exam-question-management .exam-question-bulk-actions {
    width: 100%;
    box-sizing: border-box;
    justify-content: space-between;
    align-items: center;
}

.exam-question-management .exam-question-select-label {
    display: inline-flex !important;
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    margin: 0;
    padding: 0;
    white-space: nowrap;
    cursor: pointer;
}

.exam-question-management .exam-question-select-label input[type="checkbox"] {
    display: inline-block;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    margin: 0;
}

@media (max-width: 600px) {
    .exam-question-management .exam-question-management-actions {
        justify-content: flex-start;
    }
}


/* COMPACT, SCROLLABLE EXAM QUESTION EDITOR */
.exam-question-management .exam-question-list {
    max-height: min(640px, 60vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--admin-border);
    border-radius: 10px;
    padding: 12px;
    margin: 0 0 22px;
    background: var(--admin-bg, transparent);
}

.exam-question-management .exam-question-list .scholarship-admin-form {
    box-sizing: border-box;
    margin: 0 0 12px !important;
    padding: 13px;
    border: 1px solid var(--admin-border);
    border-radius: 9px;
}

.exam-question-management .exam-question-list .scholarship-admin-form:last-child {
    margin-bottom: 0 !important;
}

.exam-question-management .exam-question-list .scholarship-form-heading {
    margin-bottom: 12px;
    padding-bottom: 8px;
    gap: 10px;
}

.exam-question-management .exam-question-list .scholarship-form-heading h2 {
    margin: 0;
    font-size: 16px;
    line-height: 1.35;
}

.exam-question-management .exam-question-list .scholarship-form-grid {
    gap: 12px;
}

.exam-question-management .exam-question-list .admin-form-field {
    gap: 5px;
}

.exam-question-management .exam-question-list textarea {
    min-height: 66px;
}

.exam-question-management .exam-question-list .scholarship-form-actions {
    margin-top: 12px;
    padding-top: 12px;
    gap: 9px;
}

.exam-question-management .exam-question-add-form[hidden] {
    display: none !important;
}

.exam-question-management .exam-question-add-form {
    margin-top: 22px;
    scroll-margin-top: 24px;
}

.exam-question-management .exam-question-add-form-actions {
    justify-content: flex-end;
}

.exam-question-management .exam-question-bottom-actions {
    justify-content: space-between;
    margin-top: 22px;
}

@media (max-width: 600px) {
    .exam-question-management .exam-question-list {
        max-height: 65vh;
        padding: 8px;
    }

    .exam-question-management .exam-question-list .scholarship-admin-form {
        padding: 10px;
    }

    .exam-question-management .exam-question-bulk-actions {
        justify-content: space-between;
        gap: 8px;
    }

    .exam-question-management .exam-question-bottom-actions {
        justify-content: space-between;
        gap: 10px;
    }
}


/* EXAM QUESTION SUMMARY ROW AND CLEAN DIVIDERS */
.exam-question-management .exam-question-summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin: 0 0 18px;
}

.exam-question-management .exam-question-summary-row .scholarship-form-heading {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.exam-question-management .exam-question-import-button {
    flex: 0 0 auto;
    margin: 0;
}

.exam-question-management .exam-question-list {
    padding: 8px 16px;
}

.exam-question-management .exam-question-list .scholarship-admin-form {
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: 16px 2px 22px;
    margin: 0 !important;
    background-image: linear-gradient(
        90deg,
        transparent 0%,
        var(--admin-border) 12%,
        var(--admin-border) 88%,
        transparent 100%
    );
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: bottom left;
}

.exam-question-management .exam-question-list .scholarship-admin-form:last-child {
    background-image: none;
    padding-bottom: 8px;
}

.exam-question-management .exam-question-list .scholarship-form-heading {
    border: 0;
    margin-bottom: 12px;
}

.exam-question-management .exam-question-list .scholarship-form-grid {
    margin-top: 0;
}

.exam-question-management .exam-question-list .scholarship-form-actions {
    border-top: 0;
    padding-top: 4px;
    margin-top: 8px;
}

@media (max-width: 650px) {
    .exam-question-management .exam-question-summary-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
    }

    .exam-question-management .exam-question-import-button {
        align-self: flex-start;
        white-space: normal;
    }

    .exam-question-management .exam-question-list {
        padding: 6px 10px;
    }
}


/* FINAL EXAM QUESTION EDITOR FIXES */
.exam-question-management .exam-question-summary-row > .exam-question-import-button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    margin: 0;
    padding: 0 13px;
    border: 1px solid var(--admin-green);
    border-radius: 7px;
    background: var(--admin-green);
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease;
}

.exam-question-management .exam-question-summary-row > .exam-question-import-button:hover {
    border-color: var(--admin-green-dark);
    background: var(--admin-green-dark);
    color: #fff;
}

/* Remove individual question cards and default fieldset outlines.
   Keep the outer scrollable list border and horizontal question dividers. */
.exam-question-management .exam-question-list > .scholarship-admin-form {
    display: block;
    box-sizing: border-box;
    border: 0 !important;
    outline: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background-color: transparent !important;
    padding: 16px 2px 22px !important;
    margin: 0 !important;
    min-width: 0;
}

.exam-question-management .exam-question-list > .scholarship-admin-form > fieldset {
    display: block;
    box-sizing: border-box;
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0 !important;
    outline: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
}

.exam-question-management .exam-question-list > .scholarship-admin-form:not(:last-child) {
    background-image: linear-gradient(
        90deg,
        transparent 0%,
        var(--admin-border) 12%,
        var(--admin-border) 88%,
        transparent 100%
    ) !important;
    background-repeat: no-repeat;
    background-position: bottom left;
    background-size: 100% 1px;
}

.exam-question-management .exam-question-list > .scholarship-admin-form:last-child {
    background-image: none !important;
}

@media (max-width: 650px) {
    .exam-question-management .exam-question-summary-row > .exam-question-import-button {
        white-space: normal;
        text-align: center;
    }
}


