@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
    --admin-green: #244E3B;
    --admin-green-dark: #193A2B;
    --admin-sage: #6D9477;
    --admin-gold: #D9A441;
    --admin-ivory: #F7F3E9;
    --admin-paper: #FFFDF8;
    --admin-ink: #252B27;
    --admin-muted: #747C73;
    --admin-border: #E5E7DE;
    --admin-sidebar: #1D4030;
    --admin-sidebar-muted: #B5C6B8;
    --admin-shadow: 0 8px 28px rgba(32, 58, 42, .045);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body.admin-body {
    margin: 0;
    background: var(--admin-ivory);
    color: var(--admin-ink);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
}

a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
button, a, select { -webkit-tap-highlight-color: transparent; }

.admin-shell { min-height: 100vh; }

.admin-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: 258px;
    padding: 27px 17px 18px;
    color: #fff;
    background:
        radial-gradient(ellipse at 0% 0%, rgba(109,148,119,.15), transparent 42%),
        var(--admin-sidebar);
    overflow-y: auto;
}

.admin-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 9px 31px;
    color: #fff;
}

.admin-brand-mark { display: grid; place-items: center; width: 42px; height: 42px; color: #E4C27A; }
.admin-brand-mark svg { width: 100%; height: 100%; }
.admin-brand strong { display: block; font-family: 'Manrope', sans-serif; font-size: 21px; letter-spacing: -.7px; }
.admin-brand small { display: block; margin-top: 3px; color: #AFC3B2; font-size: 9px; font-weight: 700; letter-spacing: 2px; }

.sidebar-label {
    padding: 0 12px 12px;
    color: #9DB5A2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.7px;
}

.admin-nav { display: grid; gap: 5px; }

.admin-nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 9px;
    color: var(--admin-sidebar-muted);
    font-size: 13px;
    font-weight: 500;
    transition: background .18s ease, color .18s ease, transform .18s ease;
}

.admin-nav-link:not(.nav-pending):hover {
    color: #fff;
    background: rgba(255,255,255,.075);
}

.admin-nav-link.active {
    color: #fff;
    background: rgba(255,255,255,.11);
    border-color: rgba(255,255,255,.075);
    box-shadow: inset 3px 0 0 #D9B76D;
}

.nav-icon {
    display: inline-grid;
    flex: 0 0 23px;
    place-items: center;
    width: 23px;
    font-size: 19px;
    line-height: 1;
    color: #B6CCB8;
}

.admin-nav-link.active .nav-icon { color: #E4C27A; }
.nav-pending { opacity: .69; cursor: default; }
.nav-soon { margin-left: auto; color: #A9BEAD; font-size: 8px; font-weight: 700; letter-spacing: .8px; }

.sidebar-bottom { margin-top: auto; padding-top: 28px; }

.admin-profile-mini {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 9px;
    border-top: 1px solid rgba(255,255,255,.12);
    border-bottom: 1px solid rgba(255,255,255,.12);
}

.admin-avatar, .topbar-avatar {
    display: grid;
    flex: 0 0 35px;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #E6D7B3;
    color: var(--admin-green-dark);
    font-weight: 800;
}

.admin-profile-copy { min-width: 0; }
.admin-profile-copy strong { display: block; max-width: 155px; overflow: hidden; color: #fff; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.admin-profile-copy span { display: block; margin-top: 4px; color: #AFC3B2; font-size: 11px; }

.sidebar-account-link, .sidebar-logout {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 11px 10px;
    border: 0;
    color: #D0DDD1;
    background: transparent;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
}
.sidebar-account-link:hover, .sidebar-logout:hover { color: #fff; }
.sidebar-logout { font-family: inherit; }
.sidebar-version { padding: 18px 9px 0; color: #789681; font-size: 8px; letter-spacing: 1px; }

.admin-main { min-height: 100vh; margin-left: 258px; }

.admin-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 69px;
    padding: 0 38px;
    border-bottom: 1px solid var(--admin-border);
    background: rgba(255,253,248,.93);
    backdrop-filter: blur(14px);
}

.topbar-context { display: flex; align-items: center; gap: 9px; color: #5D685E; font-size: 12px; font-weight: 600; }
.topbar-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--admin-sage); box-shadow: 0 0 0 4px #EAF0E7; }
.topbar-right { display: flex; align-items: center; gap: 17px; }
.topbar-date { color: var(--admin-muted); font-size: 11px; }
.topbar-avatar { width: 33px; height: 33px; flex-basis: 33px; font-size: 12px; }
.sidebar-toggle { display: none; border: 0; background: transparent; color: var(--admin-green); font-size: 22px; cursor: pointer; }

.admin-content { width: min(100%, 1550px); margin: 0 auto; padding: 32px 38px 18px; }

.welcome-panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 178px;
    padding: 29px 35px;
    border: 1px solid #E2E5DA;
    border-radius: 15px;
    background: linear-gradient(112deg, #FFFDF8 0%, #F8F5EC 67%, #EDF1E7 100%);
    overflow: hidden;
}

.welcome-copy { position: relative; z-index: 2; }
.eyebrow { display: flex; align-items: center; gap: 9px; color: #718575; font-size: 9px; font-weight: 800; letter-spacing: 1.9px; }
.eyebrow-line { display: inline-block; width: 21px; height: 2px; background: var(--admin-gold); }

.welcome-panel h1 {
    margin: 15px 0 8px;
    color: var(--admin-green-dark);
    font-family: 'Manrope', sans-serif;
    font-size: clamp(24px, 2.5vw, 34px);
    font-weight: 700;
    letter-spacing: -1.2px;
    line-height: 1.2;
}

.welcome-panel p { margin: 0; color: #70796F; font-size: 13px; line-height: 1.7; }

.welcome-decoration { position: absolute; top: -65px; right: 5%; width: 265px; height: 265px; opacity: .8; }
.decoration-ring { position: absolute; border: 1px solid rgba(109,148,119,.23); border-radius: 50%; }
.ring-one { inset: 25px; }
.ring-two { inset: 0; }
.decoration-leaf { position: absolute; top: 77px; left: 104px; color: #B6C8AD; font-size: 76px; }

.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin: 31px 0 16px; }
.section-heading h2 { margin: 0; color: var(--admin-green-dark); font-family: 'Manrope', sans-serif; font-size: 18px; font-weight: 800; letter-spacing: -.45px; }
.section-heading p { margin: 6px 0 0; color: var(--admin-muted); font-size: 12px; }

.live-indicator { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid #DDE6D8; border-radius: 20px; color: #55775C; background: #F2F6EF; font-size: 9px; font-weight: 800; letter-spacing: 1px; white-space: nowrap; }
.live-indicator span { width: 6px; height: 6px; border-radius: 50%; background: #6D9477; }

.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 15px; }

.stat-card {
    min-width: 0;
    padding: 19px 18px 17px;
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    background: var(--admin-paper);
    box-shadow: var(--admin-shadow);
    transition: transform .18s ease, box-shadow .18s ease;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(32,58,42,.075); }
.stat-featured { border-color: #D2DDCF; background: linear-gradient(145deg, #F6F8F1, #FFFDF8); }

.stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.stat-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; font-size: 21px; }
.icon-students { color: #456A50; background: #E9F0E6; }
.icon-applications { color: #8C6B31; background: #F5EFDE; }
.icon-scholarships { color: #315B43; background: #E2EDE0; }
.icon-exams { color: #6E7160; background: #ECEDE4; }
.stat-label { color: #7C8379; font-size: 9px; font-weight: 800; letter-spacing: .8px; text-align: right; }

.stat-value { margin: 20px 0 12px; color: var(--admin-green-dark); font-family: 'Manrope', sans-serif; font-size: clamp(27px, 2.6vw, 35px); font-weight: 800; letter-spacing: -1px; line-height: 1; overflow-wrap: anywhere; }
.stat-foot { display: flex; align-items: center; gap: 7px; color: #7B8178; font-size: 10px; line-height: 1.5; }
.stat-dot { flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--admin-sage); }

.management-section { margin-top: 37px; border: 1px solid var(--admin-border); border-radius: 14px; background: var(--admin-paper); box-shadow: var(--admin-shadow); overflow: hidden; scroll-margin-top: 88px; }
.table-heading { margin: 0; padding: 25px 25px 21px; align-items: center; }
.table-heading h2 { margin-top: 9px; font-size: 20px; }
.table-total { display: flex; flex-direction: column; align-items: end; gap: 4px; }
.table-total strong { color: var(--admin-green); font-family: 'Manrope', sans-serif; font-size: 23px; }
.table-total span { color: var(--admin-muted); font-size: 10px; }

.filter-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; padding: 14px 24px; border-top: 1px solid #EEEFE9; border-bottom: 1px solid #EEEFE9; background: #FBFAF5; }

.search-field { display: flex; flex: 1 1 220px; align-items: center; gap: 9px; min-width: 160px; height: 39px; padding: 0 12px; border: 1px solid #E0E4DA; border-radius: 8px; background: #fff; }
.search-field:focus-within { border-color: #8DA994; box-shadow: 0 0 0 3px rgba(109,148,119,.1); }
.search-field > span { color: #7A8A7B; font-size: 23px; line-height: 1; }
.search-field input { width: 100%; min-width: 0; border: 0; outline: 0; color: var(--admin-ink); background: transparent; font-size: 12px; }
.search-field input::placeholder { color: #9A9F95; }

.filter-bar select { height: 39px; max-width: 165px; padding: 0 29px 0 11px; border: 1px solid #E0E4DA; border-radius: 8px; outline-color: #8DA994; color: #515A51; background: #fff; font-size: 11px; cursor: pointer; }

.filter-button { height: 39px; padding: 0 16px; border: 1px solid var(--admin-green); border-radius: 8px; color: #fff; background: var(--admin-green); font-size: 11px; font-weight: 700; cursor: pointer; transition: background .15s ease; }
.filter-button:hover { background: var(--admin-green-dark); }
.clear-filters { padding: 8px 3px; color: #657768; font-size: 11px; }

.table-wrap { width: 100%; overflow-x: auto; }
.scholarship-table { width: 100%; border-collapse: collapse; text-align: left; white-space: nowrap; }
.scholarship-table thead { background: #F8F7F1; }
.scholarship-table th { padding: 13px 17px; color: #83897F; font-size: 9px; font-weight: 800; letter-spacing: .8px; }
.scholarship-table td { padding: 16px 17px; border-top: 1px solid #EFF0E9; color: #4B554C; font-size: 11px; }
.scholarship-table tbody tr { transition: background .15s ease; }
.scholarship-table tbody tr:hover { background: #FBFAF5; }
.scholarship-table th:first-child, .scholarship-table td:first-child { padding-left: 25px; }
.scholarship-table th:last-child, .scholarship-table td:last-child { padding-right: 25px; }

.opportunity-name { max-width: 245px; overflow: hidden; color: #2C4734; font-size: 12px; font-weight: 700; text-overflow: ellipsis; }
.opportunity-id { margin-top: 5px; color: #9A9F95; font-size: 9px; letter-spacing: .3px; }
.category-pill { display: inline-flex; align-items: center; padding: 6px 9px; border: 1px solid #E5E7DC; border-radius: 6px; color: #637160; background: #F8F8F1; font-size: 10px; }
.amount-cell { color: #2E513A !important; font-weight: 700; font-variant-numeric: tabular-nums; }
.deadline-date { color: #626C61; font-variant-numeric: tabular-nums; }
.muted-cell { color: #A0A59B; }

.application-count { display: inline-grid; min-width: 27px; height: 25px; place-items: center; padding: 0 7px; border-radius: 6px; color: #526A54; background: #EEF2E9; font-weight: 700; font-variant-numeric: tabular-nums; }

.status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border-radius: 20px; font-size: 10px; font-weight: 700; }
.status-pill > span { width: 6px; height: 6px; border-radius: 50%; }
.status-active { color: #376646; background: #EAF3E9; }
.status-active > span { background: #60966B; }
.status-inactive { color: #787C72; background: #EEEFE9; }
.status-inactive > span { background: #A0A398; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 40px 15px; text-align: center; white-space: normal; }
.empty-state-icon { display: grid; place-items: center; width: 42px; height: 42px; margin-bottom: 12px; border-radius: 12px; color: #55765B; background: #EAF0E6; font-size: 26px; }
.empty-state strong { color: var(--admin-green); font-size: 13px; }
.empty-state p { max-width: 360px; margin: 7px 0 0; color: var(--admin-muted); font-size: 11px; line-height: 1.7; }

.table-footer { display: flex; justify-content: space-between; gap: 12px; padding: 14px 25px; border-top: 1px solid #EFF0E9; color: #8A9086; font-size: 10px; }

.admin-footer { display: flex; justify-content: space-between; gap: 15px; padding: 24px 2px 8px; color: #969B90; font-size: 10px; }
.admin-flashes { display: grid; gap: 8px; margin-bottom: 16px; }
.admin-flash { padding: 12px 15px; border: 1px solid #DDE7D8; border-radius: 8px; color: #355B3D; background: #F0F5ED; font-size: 12px; }
.admin-flash.flash-error { border-color: #F0D6D2; color: #8B3931; background: #FFF4F1; }

@media (min-width: 1500px) {
    .admin-content { padding-right: 48px; padding-left: 48px; }
    .stats-grid { gap: 18px; }
    .stat-card { padding: 22px; }
}

@media (max-width: 1200px) {
    .admin-content { padding-right: 24px; padding-left: 24px; }
    .admin-topbar { padding-right: 24px; padding-left: 24px; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat-value { font-size: 32px; }
}

@media (max-width: 900px) {
    .admin-sidebar { transform: translateX(-100%); transition: transform .22s ease; box-shadow: 12px 0 30px rgba(0,0,0,.13); }
    .admin-sidebar.sidebar-open { transform: translateX(0); }
    .admin-main { margin-left: 0; }
    .sidebar-toggle { display: inline-grid; place-items: center; margin-right: 12px; }
    .admin-topbar { justify-content: flex-start; }
    .topbar-right { margin-left: auto; }
}

@media (max-width: 600px) {
    .admin-content { padding: 18px 13px 12px; }
    .admin-topbar { height: 59px; padding: 0 14px; }
    .topbar-date { display: none; }
    .welcome-panel { min-height: 155px; padding: 23px 19px; }
    .welcome-panel h1 { max-width: 270px; font-size: 25px; }
    .welcome-panel p { max-width: 260px; font-size: 12px; }
    .welcome-decoration { right: -125px; opacity: .42; }
    .section-heading { align-items: flex-start; }
    .stats-grid { gap: 10px; }
    .stat-card { padding: 14px 12px; }
    .stat-icon { width: 31px; height: 31px; font-size: 18px; }
    .stat-label { font-size: 8px; letter-spacing: .3px; }
    .stat-value { margin: 17px 0 10px; font-size: 29px; }
    .stat-foot { align-items: flex-start; font-size: 9px; }
    .live-indicator { padding: 6px 7px; font-size: 8px; }
    .table-heading { padding: 20px 16px; }
    .table-heading h2 { font-size: 17px; }
    .table-total strong { font-size: 19px; }
    .table-total span { font-size: 9px; }
    .filter-bar { padding: 12px; }
    .search-field { flex-basis: 100%; }
    .filter-bar select { flex: 1; max-width: none; }
    .filter-button { flex: 1; }
    .scholarship-table th { padding: 12px; }
    .scholarship-table td { padding: 14px 12px; }
    .scholarship-table th:first-child, .scholarship-table td:first-child { padding-left: 15px; }
    .scholarship-table th:last-child, .scholarship-table td:last-child { padding-right: 15px; }
    .table-footer, .admin-footer { flex-direction: column; gap: 7px; }
}

/* --- Refined admin dashboard --- */
.admin-topbar {
    display: none;
}

.mobile-admin-bar {
    display: none;
}

.admin-content {
    padding-top: 28px;
}

.stats-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
}

.stat-card {
    position: relative;
    min-height: 150px;
    padding: 20px 18px 18px 21px;
    border: 1px solid #E7E8DE;
    border-left: 3px solid #9AB39A;
    border-radius: 12px;
    background: #FFFDF8;
    box-shadow: 5px 7px 15px -10px rgba(36, 78, 59, .42);
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 7px 10px 18px -10px rgba(36, 78, 59, .48);
}

.stat-featured {
    border-left-color: #244E3B;
    background: #F1F5EC;
}

.stat-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    font-size: 23px;
}

.stat-label {
    max-width: 135px;
    color: #536458;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
}

.stat-value {
    margin: 17px 0 10px;
    font-size: clamp(30px, 2.5vw, 38px);
}

.stat-foot {
    font-size: 11px;
}

.icon-pending {
    color: #8B6B2D;
    background: #F5EEDB;
}

/* Account dropdown in the sidebar */
.admin-account-menu {
    position: relative;
    margin-top: 24px;
    border-top: 1px solid rgba(255,255,255,.13);
    padding-top: 10px;
}

.admin-account-menu summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 8px;
    border-radius: 9px;
    list-style: none;
    cursor: pointer;
}

.admin-account-menu summary::-webkit-details-marker {
    display: none;
}

.admin-account-menu summary:hover,
.admin-account-menu[open] summary {
    background: rgba(255,255,255,.07);
}

.admin-account-menu .admin-avatar {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
}

.admin-account-menu .admin-profile-copy {
    flex: 1;
}

.admin-account-menu .admin-profile-copy strong {
    font-size: 13px;
}

.account-chevron {
    color: #C5D3C6;
    font-size: 18px;
    transform: rotate(180deg);
}

.admin-account-menu[open] .account-chevron {
    transform: rotate(0);
}

.account-dropdown {
    margin: 7px 0 0;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 10px;
    background: #173526;
}

.account-dropdown-heading {
    padding: 7px 9px;
    color: #AFC3B2;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.account-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 11px 9px;
    border: 0;
    border-radius: 7px;
    color: #E1E9E0;
    background: transparent;
    font: inherit;
    font-size: 12px;
    text-align: left;
}

.account-menu-muted {
    opacity: .72;
    cursor: default;
}

.account-dropdown form {
    margin: 3px 0 0;
    border-top: 1px solid rgba(255,255,255,.12);
    padding-top: 4px;
}

.account-signout {
    cursor: pointer;
}

.account-signout:hover {
    color: #fff;
    background: rgba(255,255,255,.08);
}

.sidebar-version {
    padding-top: 14px;
}

/* Directory readability and status */
.scholarship-table {
    font-size: 13px;
}

.scholarship-table th {
    font-size: 10px;
}

.scholarship-table td {
    padding-top: 17px;
    padding-bottom: 17px;
}

.opportunity-name {
    font-size: 14px;
    font-weight: 700;
}

.status-active {
    color: #24643A;
    background: #E5F3E6;
}

.status-inactive {
    color: #A32E2E;
    background: #FBE8E6;
}

@media (max-width: 1350px) {
    .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {
    .admin-main {
        margin-left: 0;
    }

    .mobile-admin-bar {
        display: flex;
        align-items: center;
        min-height: 52px;
        padding: 6px 20px;
        border-bottom: 1px solid var(--admin-border);
        background: var(--admin-paper);
    }

    .sidebar-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
    }

    .admin-content {
        padding: 22px 20px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 520px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }

    .admin-content {
