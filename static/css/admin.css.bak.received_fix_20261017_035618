.exam-question-management .exam-question-item-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
}

.exam-question-management .exam-question-item-heading h2 {
    margin: 0;
}

.exam-question-management .exam-question-item-checkbox {
    display: inline-flex;
