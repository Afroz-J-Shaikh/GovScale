@app.route(
    "/applications/<int:application_id>/withdraw",
    methods=["POST"],
)
@student_required
def withdraw_scholarship_application(application_id):
    application = db.session.get(
        ScholarshipApplication, application_id
    )

    if application is None or application.user_id != current_user.id:
        abort(404)

    if application.scholarship.category != "grade":
        flash(
            "Only grade-based scholarship applications can be withdrawn.",
            "error",
        )
        return redirect(url_for("my_applications"))

    if application.status not in ("submitted", "pending"):
        flash(
            "This application cannot be withdrawn in its current status.",
            "error",
        )
        return redirect(url_for("my_applications"))

    application.status = "withdrawn"
    application.withdrawn_at = datetime.now()
    db.session.commit()

    flash(
        "Your application has been withdrawn. "
        "You cannot apply for this scholarship again.",
        "success",
    )
    return redirect(url_for("my_applications"))


@app.route(
    "/exam-registrations/<int:registration_id>/cancel",
    methods=["POST"],
)
@student_required
def cancel_exam_registration(registration_id):
    registration = db.session.get(
        ExamRegistration, registration_id
    )

    if registration is None or registration.user_id != current_user.id:
        abort(404)

    if registration.status != "registered":
        flash(
            "This exam registration cannot be cancelled again.",
            "error",
        )
        return redirect(url_for("my_applications"))

    india_tz = ZoneInfo("Asia/Kolkata")
    now_ist = datetime.now(india_tz).replace(tzinfo=None)

    # Cancellation closes five minutes before the scheduled start.
    registration_closes_at = (
        registration.exam.start_at - timedelta(minutes=5)
    )

    if now_ist >= registration_closes_at:
        flash(
            "The registration cancellation deadline has passed.",
            "error",
        )
        return redirect(url_for("my_applications"))

    registration.status = "cancelled"
    db.session.commit()

    flash(
        "Your exam registration has been cancelled. "
        "You cannot register for this exam again.",
        "success",
    )
    return redirect(url_for("my_applications"))

@app.route("/my-applications")
@student_required
def my_applications():
    # Keep applications visible while they are under review or awaiting reward.
    completed_application_ids = {
        row[0]
        for row in db.session.query(ScholarshipReward.application_id)
        .filter_by(user_id=current_user.id, status="completed")
        .all()
    }

    applications = (
        ScholarshipApplication.query
        .filter(
            ScholarshipApplication.user_id == current_user.id,
            ScholarshipApplication.status.in_(("submitted", "pending", "approved")),
        )
        .order_by(ScholarshipApplication.submitted_at.desc())
        .all()
    )
    applications = [
        application for application in applications
        if application.id not in completed_application_ids
    ]

    reward_by_application = {
        reward.application_id: reward
        for reward in ScholarshipReward.query.filter_by(
            user_id=current_user.id
        ).all()
        if reward.application_id not in completed_application_ids
    }

    india_tz = ZoneInfo("Asia/Kolkata")
    now_ist = datetime.now(india_tz).replace(tzinfo=None)

    # Only show registrations for active exams that have not ended.
    # Missed, completed, cancelled, and expired registrations remain in History.
    exam_registrations = (
        ExamRegistration.query
        .join(DemoExam, ExamRegistration.exam_id == DemoExam.id)
        .filter(
            ExamRegistration.user_id == current_user.id,
            ExamRegistration.status == "registered",
            DemoExam.is_active.is_(True),
            DemoExam.end_at > now_ist,
        )
        .order_by(DemoExam.start_at.asc())
        .all()
    )

    registration_deadline_by_exam = {
        registration.exam_id: (
            registration.exam.start_at - timedelta(minutes=5)
        )
        for registration in exam_registrations
    }

    return render_template(
        "my_applications.html",
        applications=applications,
        reward_by_application=reward_by_application,
        exam_registrations=exam_registrations,
        registration_deadline_by_exam=registration_deadline_by_exam,
        now_ist=now_ist,
    )


@app.route("/my-history")
@student_required
def my_history():
    close_expired_exams()

    # Only admin-confirmed payouts belong in received-reward history.
    completed_rewards = (
        ScholarshipReward.query
        .filter_by(user_id=current_user.id, status="completed")
        .filter(
            ScholarshipReward.completed_at.isnot(None),
            ScholarshipReward.completed_by_admin_id.isnot(None),
        )
        .order_by(ScholarshipReward.completed_at.desc(), ScholarshipReward.id.desc())
        .all()
    )

    # Rejections and withdrawals are decision history, not received rewards.
    application_decisions = (
        ScholarshipApplication.query
