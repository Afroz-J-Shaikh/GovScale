def refresh_one_opportunity(scholarship, now_ist=None):
    """Persist completion/expiration when an opportunity times out."""
    if now_ist is None:
        now_ist = datetime.now(
            ZoneInfo("Asia/Kolkata")
        ).replace(tzinfo=None)

    status = scholarship.lifecycle_status or (
        "active" if scholarship.is_active else "inactive"
    )

    if status in ("completed", "expired"):
        scholarship.is_active = False
        if scholarship.category == "exam":
            for linked_exam in DemoExam.query.filter_by(
                scholarship_id=scholarship.id
            ).all():
                linked_exam.is_active = False
        return False

    timed_out = False

    if scholarship.category == "grade":
        # The deadline date remains valid through that day.
        timed_out = (
            scholarship.deadline is not None
            and now_ist.date() > scholarship.deadline
        )
    elif scholarship.category == "exam":
        linked_exams = DemoExam.query.filter_by(
            scholarship_id=scholarship.id
        ).all()
        # An opportunity with no schedule is not timed out yet.
        # If it has multiple exams, all must have ended.
        timed_out = bool(linked_exams) and all(
            exam.end_at <= now_ist for exam in linked_exams
        )

    if timed_out:
        scholarship.lifecycle_status = (
            "completed" if status == "active" else "expired"
        )
        scholarship.is_active = False

        if scholarship.category == "exam":
            for linked_exam in DemoExam.query.filter_by(
                scholarship_id=scholarship.id
            ).all():
                linked_exam.is_active = False
        return True

    # Keep the existing Boolean consistent with the lifecycle status.
    scholarship.is_active = status == "active"
    return False


def notify_lifecycle_transition(scholarship, old_status, new_status):
    """Notify admins and affected students only for a real terminal transition."""
    if new_status not in ("completed", "expired") or old_status == new_status:
        return

    recipients = {
        user.id for user in User.query.filter_by(is_admin=True).all()
    }

    # Grade awards affect applicants. Exam awards affect applicants and anyone
    # registered for a linked exam.
    recipients.update(
        row[0] for row in db.session.query(ScholarshipApplication.user_id)
        .filter_by(scholarship_id=scholarship.id).distinct().all()
    )

    if scholarship.category == "exam":
        exam_ids = [
            row[0] for row in db.session.query(DemoExam.id)
            .filter_by(scholarship_id=scholarship.id).all()
        ]
        if exam_ids:
            recipients.update(
                row[0] for row in db.session.query(ExamRegistration.user_id)
                .filter(ExamRegistration.exam_id.in_(exam_ids))
                .distinct().all()
            )

    for user_id in recipients:
        dispatch_notification(
            user_id,
            f"scholarship-lifecycle:{scholarship.id}:{new_status}:user:{user_id}",
            f'Scholarship {new_status}',
            f'"{scholarship.title}" has been marked {new_status}.',
        )


def process_lifecycle_transitions(now_ist=None):
    """Refresh scholarship lifecycle statuses and notify on actual transitions."""
    if now_ist is None:
        now_ist = datetime.now(
            ZoneInfo("Asia/Kolkata")
        ).replace(tzinfo=None)

    changed = False
    for scholarship in Scholarship.query.all():
        old_status = scholarship.lifecycle_status or (
            "active" if scholarship.is_active else "inactive"
        )
        refresh_one_opportunity(scholarship, now_ist)
        new_status = scholarship.lifecycle_status or (
            "active" if scholarship.is_active else "inactive"
        )

        if old_status != new_status:
            notify_lifecycle_transition(scholarship, old_status, new_status)
            changed = True
        elif new_status in ("completed", "expired"):
            # Preserve synchronization of legacy Boolean flags.
            changed = True

    if changed or db.session.new:
        db.session.commit()


@app.route("/notifications")
@login_required
def notification_inbox():
    notifications = (
        UserNotification.query
        .filter_by(user_id=current_user.id, is_closed=False)
        .order_by(UserNotification.created_at.desc(), UserNotification.id.desc())
        .all()
    )
    for notification in notifications:
        notification.is_read = True
    db.session.commit()
    return render_template("notifications.html", notifications=notifications)


@app.route("/notifications/<int:notification_id>/open")
@login_required
def open_notification(notification_id):
    notification = db.session.get(UserNotification, notification_id)
    if notification is None or notification.user_id != current_user.id:
        abort(404)
    notification.is_read = True
    db.session.commit()
    if notification.link and notification.link.startswith("/"):
        return redirect(notification.link)
    return redirect(url_for("notification_inbox"))


@app.route("/notifications/<int:notification_id>/close", methods=["POST"])
@login_required
def close_notification(notification_id):
    notification = db.session.get(UserNotification, notification_id)
    if notification is None or notification.user_id != current_user.id:
        abort(404)

    notification.is_read = True
    notification.is_closed = True
    db.session.commit()

    if request.headers.get("X-Requested-With") == "XMLHttpRequest":
        unread_count = UserNotification.query.filter_by(
            user_id=current_user.id,
            is_read=False,
            is_closed=False,
        ).count()
        return jsonify({"success": True, "unread_count": unread_count})

    flash("Notification closed.", "success")
    return redirect(request.referrer or url_for("notification_inbox"))

@app.context_processor
def inject_notification_summary():
    if not current_user.is_authenticated:
        return {"notification_unread_count": 0, "notification_preview": []}
    unread_count = UserNotification.query.filter_by(
        user_id=current_user.id, is_read=False, is_closed=False
    ).count()
    preview = (
        UserNotification.query
        .filter_by(user_id=current_user.id, is_closed=False)
        .order_by(UserNotification.created_at.desc(), UserNotification.id.desc())
        .all()
    )
    return {
        "notification_unread_count": unread_count,
        "notification_preview": preview,
    }


