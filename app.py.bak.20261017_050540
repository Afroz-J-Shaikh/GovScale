def evaluate_scholarship_reward_eligibility(application):
    """Return (eligible, reason, exam_submission) for a reward review."""
    if application is None:
        return False, "Scholarship application not found.", None

    scholarship = application.scholarship
    user = application.user

    # Grade-based rewards still require explicit admin approval.
    # Exam-based rewards require eligibility and a passing linked exam.
    if scholarship.category == "grade" and application.status != "approved":
        return False, "The scholarship application has not been approved.", None

    eligible, reasons = check_scholarship_eligibility(user, scholarship)
    if not eligible:
        return False, " ".join(reasons), None

    if scholarship.category == "grade":
        return True, None, None

    if scholarship.category != "exam":
        return False, "This scholarship category is not supported for rewards.", None

    # Only accept a passing submission for an exam linked to this scholarship.
    linked_exam_ids = (
        db.session.query(DemoExam.id)
        .filter(DemoExam.scholarship_id == scholarship.id)
        .subquery()
    )
    submission = (
        ExamSubmission.query
        .filter(
            ExamSubmission.user_id == user.id,
            ExamSubmission.exam_id.in_(linked_exam_ids),
            ExamSubmission.passed.is_(True),
        )
        .order_by(ExamSubmission.submitted_at.desc(), ExamSubmission.id.desc())
        .first()
    )

    if submission is None:
        return (
            False,
            "A passing result for an exam linked to this scholarship is required.",
            None,
        )

    return True, None, submission


def check_scholarship_eligibility(user, scholarship):
    """Return (eligible, reasons) using GovScale's existing rules."""
    reasons = []

    if not user.indian_citizen_declared:
        reasons.append(
            "This scholarship is available to registered students "
            "who declare Indian citizenship."
        )
        return False, reasons

    if scholarship.category == "exam":
        return True, []

    if scholarship.category == "grade":
        profile = StudentProfile.query.filter_by(
            user_id=user.id
        ).first()

        if profile is None:
            reasons.append(
                "Please complete your student profile first."
            )
            return False, reasons

        if profile.education_category != scholarship.education_category:
            reasons.append(
                "Your education category does not match this "
                "scholarship's requirements."
            )

        if profile.annual_family_income is None:
            reasons.append(
                "Please add your annual family income to your profile "
                "to check eligibility."
            )
        elif profile.annual_family_income > 400000:
            reasons.append(
                "Your annual family income exceeds the maximum "
                "eligible limit of ₹4,00,000."
            )

        return not reasons, reasons

    return False, ["This scholarship category is not supported."]

@app.route("/")
def home():
    if current_user.is_authenticated and current_user.is_admin:
        return redirect(url_for("admin_dashboard"))
    india_tz = ZoneInfo("Asia/Kolkata")
    now_ist = datetime.now(india_tz).replace(tzinfo=None)

    # Show the next eligible exam on the public homepage,
    # including to visitors who are not logged in.
    upcoming_exam = (
        DemoExam.query
        .join(
            Scholarship,
            DemoExam.scholarship_id == Scholarship.id,
        )
        .filter(
            DemoExam.is_active.is_(True),
            DemoExam.end_at > now_ist,
            Scholarship.is_active.is_(True),
            Scholarship.lifecycle_status == "active",
            Scholarship.category == "exam",
        )
        .order_by(DemoExam.start_at.asc())
        .first()
    )

    upcoming_exam_registration = None

    if current_user.is_authenticated and upcoming_exam:
        upcoming_exam_registration = ExamRegistration.query.filter_by(
            user_id=current_user.id,
            exam_id=upcoming_exam.id,
        ).first()

    upcoming_exam_start_iso = (
        upcoming_exam.start_at.replace(
            tzinfo=india_tz
        ).isoformat()
        if upcoming_exam else None
    )

    query = Scholarship.query.filter_by(is_active=True)

    if current_user.is_authenticated:
        profile = StudentProfile.query.filter_by(
            user_id=current_user.id
        ).first()

        if profile:
            query = query.filter(
                db.or_(
                    Scholarship.category == "exam",
                    db.and_(
                        Scholarship.category == "grade",
                        Scholarship.education_category
                        == profile.education_category,
                    ),
                )
            )
        else:
            # Until a student saves their education category,
            # show only exam-based scholarships.
            query = query.filter(Scholarship.category == "exam")

    
    scholarships = query.order_by(
        Scholarship.deadline.asc(),
        Scholarship.id.asc(),
    ).all()

    visible_exam_scholarship_ids = {
        row[0]
        for row in db.session.query(DemoExam.scholarship_id)
        .join(Scholarship, DemoExam.scholarship_id == Scholarship.id)
        .filter(
            DemoExam.is_active.is_(True),
            DemoExam.start_at > now_ist,
            Scholarship.is_active.is_(True),
            Scholarship.category == "exam",
        )
        .all()
    }

    scholarships = [
        scholarship for scholarship in scholarships
        if scholarship.category != "exam"
        or scholarship.id in visible_exam_scholarship_ids
    ]

    # Exam catalogue deadlines are five minutes before the linked exam.
    # Grade-based scholarships continue to use Scholarship.deadline.
    exam_registration_deadline_by_scholarship = {}
    if any(item.category == "exam" for item in scholarships):
        linked_exams = (
            DemoExam.query
            .join(Scholarship, DemoExam.scholarship_id == Scholarship.id)
            .filter(
                DemoExam.is_active.is_(True),
                DemoExam.start_at > now_ist,
                DemoExam.end_at > now_ist,
                Scholarship.is_active.is_(True),
                Scholarship.category == "exam",
            )
            .order_by(DemoExam.start_at.asc())
            .all()
        )
        for exam in linked_exams:
            exam_registration_deadline_by_scholarship.setdefault(
                exam.scholarship_id,
                exam.start_at - timedelta(minutes=5),
            )

    # Homepage metrics use global database totals, independent of
    # the personalized scholarship list shown to a logged-in student.
    active_scholarship_filter = (
        Scholarship.is_active.is_(True),
        Scholarship.lifecycle_status == "active",
    )

    impact_active_count = Scholarship.query.filter(
        *active_scholarship_filter
    ).count()

    impact_applications_count = ScholarshipApplication.query.count()

    # Exclude administrator accounts from student reach.
    impact_students_count = User.query.filter(
        User.is_admin.is_(False)
    ).count()

    impact_grade_count = Scholarship.query.filter(
        *active_scholarship_filter,
        Scholarship.category == "grade",
    ).count()

    impact_exam_count = Scholarship.query.filter(
        *active_scholarship_filter,
        Scholarship.category == "exam",
    ).count()

    # Only administrator-confirmed completed payouts count as paid.
    confirmed_rewards = ScholarshipReward.query.filter(
        ScholarshipReward.status == "completed",
        ScholarshipReward.completed_at.isnot(None),
        ScholarshipReward.completed_by_admin_id.isnot(None),
    )

    impact_scholarships_awarded = confirmed_rewards.count()

    impact_total_rewards_paid = (
        db.session.query(
            db.func.coalesce(db.func.sum(ScholarshipReward.amount), 0)
        )
        .filter(
            ScholarshipReward.status == "completed",
            ScholarshipReward.completed_at.isnot(None),
            ScholarshipReward.completed_by_admin_id.isnot(None),
        )
        .scalar()
        or 0
    )

    impact_students_awarded = (
        db.session.query(
            db.func.count(db.func.distinct(ScholarshipReward.user_id))
        )
        .filter(
            ScholarshipReward.status == "completed",
            ScholarshipReward.completed_at.isnot(None),
            ScholarshipReward.completed_by_admin_id.isnot(None),
        )
        .scalar()
        or 0
    )

    # Count registered students for active exams that have not ended.
    # This includes an active exam whose scheduled start time is upcoming.
    impact_exam_participants = (
        ExamRegistration.query
        .join(DemoExam, ExamRegistration.exam_id == DemoExam.id)
        .filter(
            DemoExam.is_active.is_(True),
            DemoExam.end_at > now_ist,
            ExamRegistration.status == "registered",
        )
        .count()
    )

    return render_template(
        "index.html",
        scholarships=scholarships,
        impact_active_count=impact_active_count,
        impact_applications_count=impact_applications_count,
        impact_students_count=impact_students_count,
        impact_grade_count=impact_grade_count,
        impact_exam_count=impact_exam_count,
        impact_scholarships_awarded=impact_scholarships_awarded,
        impact_total_rewards_paid=impact_total_rewards_paid,
        impact_students_awarded=impact_students_awarded,
        impact_exam_participants=impact_exam_participants,
        upcoming_exam=upcoming_exam,
        upcoming_exam_start_iso=upcoming_exam_start_iso,
        upcoming_exam_registration=upcoming_exam_registration,
        exam_registration_deadline_by_scholarship=(
            exam_registration_deadline_by_scholarship
        ),
    )



@app.route("/scholarships/<int:scholarship_id>")
def scholarship_detail(scholarship_id):
    scholarship = db.session.get(Scholarship, scholarship_id)
    if scholarship is None:
        abort(404)

    if (
        not scholarship.is_active
        or scholarship.lifecycle_status != "active"
    ):
        approved_existing = False

        if (
            current_user.is_authenticated
            and scholarship.category == "grade"
        ):
            approved_existing = (
                ScholarshipApplication.query.filter_by(
                    user_id=current_user.id,
                    scholarship_id=scholarship.id,
                    status="approved",
                ).first()
                is not None
            )

        if not approved_existing:
            abort(404)

    linked_exam = None
    if scholarship.category == "exam":
        linked_exam = (
            DemoExam.query
            .filter_by(
                scholarship_id=scholarship.id,
                is_active=True,
            )
            .order_by(DemoExam.start_at.asc())
            .first()
        )
   
    india_tz = ZoneInfo("Asia/Kolkata")
    now_ist = datetime.now(india_tz).replace(tzinfo=None)

    if scholarship.category == "exam":
        if linked_exam is None or linked_exam.end_at <= now_ist:
            abort(404)

        if now_ist >= linked_exam.start_at:
            active_registration = None
            if current_user.is_authenticated:
                active_registration = ExamRegistration.query.filter_by(
                    user_id=current_user.id,
                    exam_id=linked_exam.id,
                    status="registered",
                ).first()
            if active_registration is None:
                abort(404)

    exam_registration = None
    registration_status = None
    registration_closes_at = None

    if linked_exam:
        registration_closes_at = (
            linked_exam.start_at - timedelta(minutes=5)
        )

        if linked_exam.end_at <= now_ist:
            registration_status = "finished"
        elif linked_exam.registration_opens_at is None:
            registration_status = "unconfigured"
        elif (
            linked_exam.title != "GovScale Phase 2 Demo Exam"
            and linked_exam.registration_opens_at > (
                linked_exam.start_at - timedelta(days=1)
            )
        ):
            registration_status = "invalid"
        elif now_ist < linked_exam.registration_opens_at:
            registration_status = "upcoming"
        elif now_ist >= registration_closes_at:
            registration_status = "closed"
        else:
            registration_status = "open"

        if current_user.is_authenticated:
            exam_registration = ExamRegistration.query.filter_by(
                user_id=current_user.id,
                exam_id=linked_exam.id,
            ).first()

    eligible = None
    ineligible_reasons = []

    if current_user.is_authenticated:
        eligible, ineligible_reasons = (
            check_scholarship_eligibility(
                current_user, scholarship
            )
        )

    existing_application = None

    if current_user.is_authenticated:
        existing_application = ScholarshipApplication.query.filter_by(
            user_id=current_user.id,
            scholarship_id=scholarship.id,
        ).first()

    received_reward = False
    if current_user.is_authenticated and existing_application:
        received_reward = ScholarshipReward.query.filter(
            ScholarshipReward.application_id == existing_application.id,
            ScholarshipReward.user_id == current_user.id,
            ScholarshipReward.scholarship_id == scholarship.id,
            ScholarshipReward.status == "completed",
            ScholarshipReward.completed_at.isnot(None),
            ScholarshipReward.completed_by_admin_id.isnot(None),
        ).first() is not None

    return render_template(
        "scholarship_detail.html",
        scholarship=scholarship,
        received_reward=received_reward,
        eligible=eligible,
        ineligible_reasons=ineligible_reasons,
        existing_application=existing_application,
        linked_exam=linked_exam,
        exam_registration=exam_registration,
        registration_status=registration_status,
        registration_closes_at=registration_closes_at,
        now_ist=now_ist,
    )

@app.route("/exams/<int:exam_id>/register", methods=["POST"])
@student_required
def register_for_exam(exam_id):
    exam = db.session.get(DemoExam, exam_id)

    if exam is None or not exam.is_active:
        abort(404)

    scholarship = db.session.get(Scholarship, exam.scholarship_id)

    if (
        scholarship is None
        or not scholarship.is_active
        or scholarship.category != "exam"
    ):
        abort(404)

    india_tz = ZoneInfo("Asia/Kolkata")
    now_ist = datetime.now(india_tz).replace(tzinfo=None)

    # Registration closes five minutes before the scheduled start.
    registration_closes_at = exam.start_at - timedelta(minutes=5)

    if exam.registration_opens_at is None:
        flash("Registration is not open yet.", "error")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    if now_ist < exam.registration_opens_at:
        flash("Registration has not opened yet.", "error")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    if now_ist >= exam.end_at:
        flash("This exam has already finished.", "error")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    is_demo_fast_start = exam.title == "GovScale Phase 2 Demo Exam"

    if now_ist >= registration_closes_at:
        flash("Registration for this exam has closed.", "error")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    # Normal exams require 24 hours' notice. The named demo is intentionally
    # exempt so students can test registration shortly before its start.
    if (
        not is_demo_fast_start
        and exam.registration_opens_at > (
            exam.start_at - timedelta(days=1)
        )
    ):
        flash(
            "This exam's registration schedule is invalid. "
            "Please contact the portal administrator.",
            "error",
        )
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    eligible, reasons = check_scholarship_eligibility(
        current_user, scholarship
    )

    if not eligible:
        for reason in reasons:
            flash(reason, "error")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    existing_registration = ExamRegistration.query.filter_by(
        user_id=current_user.id,
        exam_id=exam.id,
    ).first()

    if existing_registration:
        if existing_registration.status == "cancelled":
            flash(
                "You previously cancelled this registration. "
                "You cannot register for this exam again.",
                "error",
            )
        else:
            flash("You are already registered for this exam.", "info")

        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    # Keep one application record per student and scholarship.
    application = ScholarshipApplication.query.filter_by(
        user_id=current_user.id,
        scholarship_id=scholarship.id,
    ).first()

    if application and application.status in ("rejected", "withdrawn"):
        flash(
            "You cannot register because this scholarship application "
            "has already been rejected or withdrawn.",
            "error",
        )
        return redirect(
            url_for("scholarship_detail", scholarship_id=scholarship.id)
        )

    registration = ExamRegistration(
        user_id=current_user.id,
        exam_id=exam.id,
        status="registered",
    )
    db.session.add(registration)

    if application is None:
        application = ScholarshipApplication(
            user_id=current_user.id,
            scholarship_id=scholarship.id,
            status="submitted",
        )
        db.session.add(application)

    notify_user(
        current_user.id,
        "Exam registration confirmed",
        f'You have successfully registered for "{exam.title}".',
        url_for("scholarship_detail", scholarship_id=scholarship.id),
    )

    try:
        db.session.commit()
    except IntegrityError:
        db.session.rollback()
        flash("You are already registered for this exam.", "info")
        return redirect(
            url_for(
                "scholarship_detail",
                scholarship_id=scholarship.id,
            )
        )

    flash("You are successfully registered for the exam.", "success")
    return redirect(
        url_for(
            "scholarship_detail",
            scholarship_id=scholarship.id,
        )
    )

